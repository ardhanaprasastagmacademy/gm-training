---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/ui/PageBanner.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";
import { siteConfig } from "../../data/site";
const aboutSchema = {
  "@type": "AboutPage",
  "@id": `${siteConfig.url}/tentang/#webpage`,
  name: `Tentang ${siteConfig.shortName}`,
  description:
    "Mengenal latar belakang, visi, nilai integritas, dan standar layanan Program Magang terstruktur Gemilang Training di Kota Malang.",
  mainEntity: {
    "@id": `${siteConfig.url}/#organization`,
  },
};
---

<BaseLayout
  title={`Tentang Program Magang SMK & Mahasiswa | ${siteConfig.shortName}`}
  description="Mengenal latar belakang, visi, nilai integritas, dan standar layanan Program Magang terstruktur Gemilang Training bersama konsorsium industri teknologi."
  canonical={`${siteConfig.url}/tentang/`}
  schema={aboutSchema}
>
  <PageBanner
    title="Tentang Gemilang Training"
    description="Menghubungkan talenta muda kejuruan dan perguruan tinggi dengan industri nasional melalui magang terstruktur."
    breadcrumbs={[{ label: "Tentang" }]}
  />

  <!-- 2. Section 1: The Story Split (Matching Reference Section 1) -->
  <section class="py-14 md:py-20 bg-[#F8F9FA] text-gray-900 overflow-hidden">
    <div class="max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <!-- Text Column: Below photo on mobile (order-2), Left on desktop (lg:order-1) -->
        <div class="lg:col-span-7 space-y-6 order-2 lg:order-1">
          <h2 class="text-3xl sm:text-4xl md:text-[2.65rem] font-extrabold text-gray-900 leading-[1.18] tracking-tight">
            Magang Informatika Seharusnya <br class="hidden sm:inline" />
            <span class="text-maroon-700">Tidak Rumit</span> &amp; Berdampak Nyata
          </h2>

          <div class="space-y-4 text-gray-600 text-base md:text-lg leading-relaxed">
            <p>
              Banyak siswa SMK (RPL, TKJ, Multimedia), mahasiswa teknik informatika, dan institusi pendidikan di Kota Malang dan sekitarnya menghadapi keraguan saat mencari tempat magang: tugas yang tidak relevan dengan teknologi, minimnya arahan dari praktisi senior, hingga ketidakjelasan sertifikasi resmi.
            </p>
            <p>
              Di <strong>{siteConfig.name}</strong> yang berpusat di area strategis {siteConfig.address.street} {siteConfig.address.city}, Anda tidak perlu berspekulasi dengan masa depan karier Anda. Kami hadir dengan komitmen transparansi mutlak, kurikulum proyek industri IT terstruktur, pembinaan coding & arsitektur sistem, serta penugasan nyata berstandar industri.
            </p>
          </div>

          <!-- Feature Bullets -->
          <div class="pt-2 grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-xs md:text-sm font-semibold text-gray-800">
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-maroon-100 text-maroon-700 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Silabus Praktik Sesuai DUDI</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-maroon-100 text-maroon-700 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Bimbingan 1-on-1 Mentor Senior</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-maroon-100 text-maroon-700 flex items-center justify-center text-xs font-bold">✓</span>
              <span>MoU Resmi Sekolah &amp; Kampus</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-maroon-100 text-maroon-700 flex items-center justify-center text-xs font-bold">✓</span>
              <span>100% Bebas Biaya Pendaftaran</span>
            </div>
          </div>
        </div>

        <!-- Photo Column: On top on mobile (order-1), Right on desktop (lg:order-2) -->
        <div class="lg:col-span-5 flex justify-center order-1 lg:order-2">
          <div class="relative w-full max-w-md group">
            <!-- Organic frame shadow -->
            <div class="absolute -inset-2 bg-gradient-to-tr from-maroon-950 via-maroon-900 to-black rounded-[36px] opacity-20 blur-lg transition-all duration-500 group-hover:opacity-30"></div>
            
            <div class="relative rounded-[32px] overflow-hidden bg-white p-3.5 border border-gray-200/90 shadow-2xl">
              <div class="aspect-[4/3] rounded-[24px] overflow-hidden bg-gray-100 relative">
                <img
                  src="/images/galeri/galeri-1.webp"
                  alt="Suasana Pendampingan Mentor Praktisi Gemilang Training"
                  width="800"
                  height="600"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <!-- Floating badge caption on frame -->
              <div class="pt-3.5 pb-1 px-3 text-center">
                <span class="text-xs uppercase tracking-wider font-extrabold text-maroon-700 block mb-0.5">
                  Bimbingan Nyata di Lini Kerja
                </span>
                <p class="text-[0.75rem] text-gray-500">
                  Mentor praktisi industri mendampingi pemecahan masalah dan pengarahan langsung 1-on-1.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Section 2: Dark Burgundy Ribbon with Wave Borders & 3 Key Metrics (Matching Reference Dark Ribbon) -->
  <section class="relative bg-[#160408] text-white py-16 md:py-24 overflow-hidden">
    <!-- Top Organic Wave Entering Dark Section -->
    <div class="absolute top-0 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
      <svg class="relative block w-full h-8 md:h-12" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0 L1200,0 L1200,40 C1050,90 850,20 600,65 C380,105 150,30 0,60 Z" fill="#F8F9FA"></path>
      </svg>
    </div>

    <div class="relative z-10 max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 text-center">
        <!-- Metric 1: Tahun Dedikasi -->
        <div class="space-y-3 group">
          <div class="w-14 h-14 mx-auto rounded-2xl bg-white/10 text-rose-300 flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform">
            <!-- Ribbon/Medal SVG Icon -->
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="8" r="6"></circle>
              <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
            </svg>
          </div>
          <h3 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">
            5+ Tahun Dedikasi
          </h3>
          <p class="text-xs md:text-sm text-gray-300 leading-relaxed max-w-xs mx-auto font-normal">
            Pengalaman teruji menjembatani ribuan talenta SMK &amp; mahasiswa ke ekosistem industri.
          </p>
        </div>

        <!-- Metric 2: Mitra Instansi -->
        <div class="space-y-3 group">
          <div class="w-14 h-14 mx-auto rounded-2xl bg-white/10 text-rose-300 flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform">
            <!-- Building/Network SVG Icon -->
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 21h18"></path>
              <path d="M5 21V7l8-4v18"></path>
              <path d="M19 21V11l-6-4"></path>
              <path d="M9 9h1"></path>
              <path d="M9 13h1"></path>
              <path d="M9 17h1"></path>
            </svg>
          </div>
          <h3 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">
            50+ Mitra Industri
          </h3>
          <p class="text-xs md:text-sm text-gray-300 leading-relaxed max-w-xs mx-auto font-normal">
            Korporasi teknologi informasi, manufaktur presisi, studio kreatif, dan logistik terpercaya.
          </p>
        </div>

        <!-- Metric 3: Bebas Cemas -->
        <div class="space-y-3 group">
          <div class="w-14 h-14 mx-auto rounded-2xl bg-white/10 text-rose-300 flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform">
            <!-- Shield Check SVG Icon -->
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <h3 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">
            100% Bebas Cemas
          </h3>
          <p class="text-xs md:text-sm text-gray-300 leading-relaxed max-w-xs mx-auto font-normal">
            Tanpa biaya tersembunyi, bimbingan 1-on-1, dan jaminan sertifikat resmi berstandar industri.
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Organic Wave Exiting Dark Section -->
    <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
      <svg class="relative block w-full h-8 md:h-12" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0 C150,85 380,20 600,65 C850,115 1050,30 1200,60 L1200,120 L0,120 Z" fill="#F8F9FA"></path>
      </svg>
    </div>
  </section>

  <!-- 4. Section 3: Standar Layanan Gemilang Training (3 Cards Grid matching Reference) -->
  <section class="py-16 md:py-24 bg-[#F8F9FA] text-gray-900">
    <div class="max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight tracking-tight">
          Standar Layanan Gemilang Training <br class="hidden sm:inline" />
          untuk Keberhasilan Peserta &amp; Mitra
        </h2>
        <p class="text-gray-600 text-sm md:text-base leading-relaxed mt-3.5 font-normal">
          Kami menyelaraskan kebutuhan representasi kompetensi peserta didik dengan kurikulum terstruktur, pendampingan mentor terpadu, dan jaminan purna magang menyeluruh.
        </p>
      </div>

      <!-- 3 Cards Grid with Distinct Harmonic Tint Styles (Matching Reference) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <!-- Card 1: Kurasi Silabus Teruji (Warm Sand / Rose Tint) -->
        <div class="bg-[#F5EBE6] border border-rose-200/70 rounded-[28px] overflow-hidden text-gray-900 flex flex-col justify-between shadow-sm hover:-translate-y-1.5 hover:shadow-xl transition-all duration-300 group">
          <div>
            <!-- Image Container -->
            <div class="aspect-[16/10] overflow-hidden bg-white relative">
              <img
                src="/images/galeri/galeri-3.webp"
                alt="Kurikulum Terstruktur & Teruji"
                width="600"
                height="375"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="text-lg md:text-xl font-extrabold text-gray-900 group-hover:text-maroon-700 transition-colors mb-2.5">
                Kurasi Silabus Teruji
              </h3>
              <p class="text-xs md:text-sm text-gray-600 leading-relaxed font-normal">
                Setiap materi penugasan, modul kerja, dan praktik kejuruan dirancang terukur agar relevan dengan kebutuhan industri dan memenuhi kriteria penilaian PKL.
              </p>
            </div>
          </div>
        </div>

        <!-- Card 2: Dukungan Mentoring Terpadu (Warm Ivory Tint) -->
        <div class="bg-[#FAF6F0] border border-stone-200/90 rounded-[28px] overflow-hidden text-gray-900 flex flex-col justify-between shadow-sm hover:-translate-y-1.5 hover:shadow-xl transition-all duration-300 group">
          <div>
            <!-- Image Container -->
            <div class="aspect-[16/10] overflow-hidden bg-white relative">
              <img
                src="/images/galeri/galeri-2.webp"
                alt="Dukungan Mentoring Terpadu"
                width="600"
                height="375"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="text-lg md:text-xl font-extrabold text-gray-900 group-hover:text-maroon-700 transition-colors mb-2.5">
                Dukungan Mentoring Terpadu
              </h3>
              <p class="text-xs md:text-sm text-gray-600 leading-relaxed font-normal">
                Peserta tidak dibiarkan bekerja sendiri. Tim mentor praktisi mendampingi transfer keahlian teknis, evaluasi berkala, hingga penyusunan laporan proyek akhir.
              </p>
            </div>
          </div>
        </div>

        <!-- Card 3: Jaminan & Legalitas Resmi (Deep Maroon Card) -->
        <div class="bg-[#3D0510] border border-maroon-800 rounded-[28px] overflow-hidden text-white flex flex-col justify-between shadow-lg shadow-maroon-950/20 hover:-translate-y-1.5 hover:shadow-2xl transition-all duration-300 group">
          <div>
            <!-- Image Container -->
            <div class="aspect-[16/10] overflow-hidden bg-black/25 relative">
              <img
                src="/images/galeri/galeri-4.webp"
                alt="Jaminan & Kepastian Mitra Resmi"
                width="600"
                height="375"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="text-lg md:text-xl font-extrabold text-white mb-2.5">
                Jaminan &amp; Legalitas Resmi
              </h3>
              <p class="text-xs md:text-sm text-rose-100/90 leading-relaxed font-normal">
                Jadwal pelaksanaan terikat komitmen kerja sama resmi, MoU bersama sekolah/kampus, serta sertifikasi industri bernomor registrasi resmi.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Section 4: Wide Squircle Dark CTA Card -->
  <CtaBanner
    title="Butuh Penyaluran Program Magang dengan Skema Khusus?"
    subtitle="Setiap institusi pendidikan memiliki kalender akademik dan kurikulum yang berbeda. Tim konsultan kemitraan Gemilang Training siap membantu sinkronisasi MoU, alokasi kuota batch, hingga kurikulum penugasan khusus."
    primaryText="Diskusikan Skema Kemitraan"
    primaryHref="/untuk-sekolah-kampus/"
  />
</BaseLayout>
