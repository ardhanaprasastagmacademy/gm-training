---
import { siteConfig } from "../../data/site";

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumbs: Crumb[];
  badge?: string;
  centered?: boolean;
}

const { title, description, breadcrumbs = [] } = Astro.props;
const cleanTitle = (title || "").replace(/&amp;/g, "&");

// Build breadcrumb items starting with Beranda
const allCrumbs = [{ label: "Beranda", href: "/" }, ...breadcrumbs];

// Structured Data Schema for Breadcrumbs
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: allCrumbs.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item: item.href ? new URL(item.href, siteConfig.url).toString() : undefined,
  })),
};
---

<!-- JSON-LD Breadcrumb Schema -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<header
  class="relative w-full overflow-hidden bg-[#0A0305] text-white pt-[108px] sm:pt-[118px] md:pt-[132px] pb-16 sm:pb-20 md:pb-24"
>
  <!-- Atmospheric Photography Background (Full Bleed Edge-to-Edge) -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <img
      src="/images/pagebanner.webp"
      alt=""
      class="w-full h-full object-cover object-center opacity-45 brightness-95"
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Vignette Gradients -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/35 md:to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-[#0A0305] via-transparent to-black/50"
    >
    </div>
  </div>

  <!-- Centered Header Content (Matching Reference Layout) -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center flex flex-col items-center">
    <!-- Centered Breadcrumbs Pill -->
    <nav aria-label="Breadcrumb" class="mb-3">
      <ol class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/20 backdrop-blur-md text-xs font-semibold text-rose-200 shadow-sm flex-wrap justify-center">
        {
          allCrumbs.map((crumb, idx) => {
            const isLast = idx === allCrumbs.length - 1;
            return (
              <li class="inline-flex items-center gap-2">
                {idx > 0 && <span class="opacity-40 select-none">•</span>}
                {isLast || !crumb.href ? (
                  <span class="text-white font-bold" aria-current="page">
                    {crumb.label}
                  </span>
                ) : (
                  <a href={crumb.href} class="hover:text-white transition-colors">
                    {crumb.label}
                  </a>
                )}
              </li>
            );
          })
        }
      </ol>
    </nav>

    <!-- Main H1 Title -->
    <h1
      class="text-2xl sm:text-3xl md:text-4xl lg:text-[2.6rem] font-extrabold text-white tracking-tight leading-tight mb-3.5 drop-shadow-md text-center max-w-3xl mx-auto"
    >
      {cleanTitle}
    </h1>

    <!-- Centered Description Paragraph (Slightly Reduced & Compact) -->
    {
      description && (
        <p class="text-xs sm:text-sm md:text-[0.9375rem] text-gray-200/90 max-w-xl mx-auto leading-relaxed font-normal drop-shadow-xs text-center">
          {description}
        </p>
      )
    }
  </div>

  <!-- Smooth Organic Bottom Wave (Transitioning seamlessly into #F8F9FA) -->
  <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none z-10 pointer-events-none">
    <svg class="relative block w-full h-8 md:h-12" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M0,0 C150,85 380,20 600,65 C850,115 1050,30 1200,60 L1200,120 L0,120 Z" fill="#F8F9FA"></path>
    </svg>
  </div>
</header>
