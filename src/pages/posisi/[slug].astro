---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/ui/PageBanner.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";
import { siteConfig } from "../../data/site";

export async function getStaticPaths() {
  const allPosisi = await getCollection("posisi", ({ data }) => !data.draft);
  return allPosisi.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const data = item.data;

// Resolve references
const mitraDoc = await getEntry("mitra", data.mitra.id);
const batchDoc = await getEntry("batch", data.batch.id);

if (!mitraDoc || !batchDoc) {
  throw new Error(`Data referensi mitra atau batch tidak ditemukan untuk posisi: ${item.id}`);
}

const mitra = mitraDoc.data;
const batch = batchDoc.data;

const modeLabels = {
  onsite: "Kerja di Lokasi (Onsite)",
  hybrid: "Gabungan (Hybrid)",
  remote: "Jarak Jauh (Remote)",
};

const jalurLabels = {
  smk: "Khusus Siswa SMK (PKL)",
  mahasiswa: "Khusus Mahasiswa (Konversi SKS)",
  keduanya: "Terbuka untuk Siswa SMK & Mahasiswa",
};

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "Asia/Jakarta",
  }).format(date);

// JobPosting JSON-LD Schema (SEO-STRATEGY.md 7.4)
const jobPostingSchema = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  title: `Magang ${data.judul}`,
  description: `<p>${item.body || data.judul}</p>`,
  datePosted: batch.tanggalBuka.toISOString().split("T")[0],
  validThrough: batch.tanggalTutup.toISOString(),
  employmentType: "INTERN",
  hiringOrganization: {
    "@type": "Organization",
    name: mitra.nama,
    sameAs: mitra.website || siteConfig.url,
  },
  jobLocation: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressLocality: data.lokasi,
      addressCountry: "ID",
    },
  },
};
---

<BaseLayout
  title={`Magang ${data.judul} di ${mitra.nama}, ${data.lokasi} | ${siteConfig.shortName}`}
  description={`Lowongan magang ${data.judul} bersama ${mitra.nama} di ${data.lokasi}. Durasi ${data.durasiBulan} bulan dengan kurikulum kompetensi terstruktur.`}
  schema={jobPostingSchema}
>
  <PageBanner
    title={data.judul}
    description={`Penempatan magang resmi bersama ${mitra.nama} di ${data.lokasi}.`}
    breadcrumbs={[
      { label: "Posisi Magang", href: "/posisi/" },
      { label: data.judul },
    ]}
    badge={jalurLabels[data.jalur]}
  />

  <section class="py-14 md:py-20 bg-[#F8F9FA] text-gray-900">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <!-- Main Job Description (8 cols) -->
        <div class="lg:col-span-8 space-y-8">
          <!-- Overview badges -->
          <div class="flex flex-wrap items-center gap-2.5 pb-6 border-b border-gray-200/80">
            <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold bg-maroon-50 text-maroon-700 border border-maroon-100">
              Bidang: {data.bidang}
            </span>
            <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-medium border border-gray-200 text-gray-700 bg-white shadow-2xl">
              {modeLabels[data.mode]}
            </span>
            <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-medium border border-gray-200 text-gray-700 bg-white">
              Durasi: {data.durasiBulan} Bulan
            </span>
            {data.kuotaAwal && (
              <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-medium border border-gray-200 text-gray-700 bg-white">
                Kuota Awal: {data.kuotaAwal} Peserta
              </span>
            )}
          </div>

          <!-- Description -->
          <div class="bg-white border border-gray-200/90 rounded-[24px] p-6 md:p-8 shadow-sm">
            <h2 class="text-xl md:text-2xl font-extrabold text-gray-900 mb-4 tracking-tight">
              Tentang Posisi Ini
            </h2>
            <div class="text-gray-600 text-sm md:text-base leading-relaxed space-y-4">
              <p>{item.body}</p>
            </div>
          </div>

          <!-- Tugas Utama -->
          <div class="bg-white border border-gray-200/90 rounded-[24px] p-6 md:p-8 shadow-sm">
            <h2 class="text-xl md:text-2xl font-extrabold text-gray-900 mb-5 tracking-tight">
              Tugas & Tanggung Jawab Utama
            </h2>
            <ul class="space-y-3.5 text-gray-700 text-sm md:text-base">
              {data.tugas.map((t) => (
                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-maroon-50 border border-maroon-100 text-maroon-700 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                    ✓
                  </div>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Kualifikasi -->
          <div class="bg-white border border-gray-200/90 rounded-[24px] p-6 md:p-8 shadow-sm">
            <h2 class="text-xl md:text-2xl font-extrabold text-gray-900 mb-5 tracking-tight">
              Kualifikasi & Persyaratan Kemampuan
            </h2>
            <ul class="space-y-3.5 text-gray-700 text-sm md:text-base">
              {data.kualifikasi.map((k) => (
                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-gray-100 text-maroon-700 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                    •
                  </div>
                  <span>{k}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Jurusan Relevan -->
          <div class="bg-white border border-gray-200/90 rounded-[24px] p-6 md:p-8 shadow-sm">
            <h2 class="text-xl font-extrabold text-gray-900 mb-4 tracking-tight">
              Jurusan / Program Studi yang Sangat Relevan
            </h2>
            <div class="flex flex-wrap gap-2">
              {data.jurusanRelevan.map((j) => (
                <span class="px-3.5 py-1.5 rounded-full bg-gray-50 text-gray-800 border border-gray-200 text-xs font-semibold">
                  {j}
                </span>
              ))}
            </div>
          </div>

          <!-- Benefit -->
          {data.benefit && data.benefit.length > 0 && (
            <div class="p-6 md:p-8 bg-maroon-50/70 border border-maroon-100 rounded-[24px]">
              <h2 class="text-xl font-extrabold text-gray-900 mb-5 tracking-tight flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-maroon-700"></span>
                <span>Fasilitas & Manfaat Magang</span>
              </h2>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-sm text-gray-700">
                {data.benefit.map((b) => (
                  <li class="flex items-center gap-2.5">
                    <span class="w-2 h-2 rounded-full bg-maroon-700 shrink-0"></span>
                    <span class="font-medium">{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- Sticky Sidebar Application Card (4 cols) -->
        <aside class="lg:col-span-4 sticky top-24 space-y-6">
          <div class="bg-white border border-gray-200/90 rounded-[24px] p-6 shadow-sm text-gray-900">
            <div class="mb-4">
              <span class="text-xs font-bold uppercase tracking-[0.2em] text-maroon-700 block mb-1">
                Penyedia Penempatan
              </span>
              <div class="flex items-center gap-2.5 font-bold text-gray-900 text-lg">
                {mitra.logo && (
                  <img src={mitra.logo} alt="" class="w-6 h-6 object-contain rounded p-0.5 bg-gray-50 border border-gray-200" aria-hidden="true" />
                )}
                <span>{mitra.nama}</span>
              </div>
              <p class="text-xs text-gray-500 mt-1">{mitra.sektor}</p>
            </div>

            <div class="space-y-3 pt-4 border-t border-gray-100 text-xs text-gray-600 mb-6">
              <div class="flex justify-between py-1.5 border-b border-gray-100">
                <span class="text-gray-500">Batch:</span>
                <span class="font-bold text-gray-900">{batch.nama}</span>
              </div>
              <div class="flex justify-between py-1.5 border-b border-gray-100">
                <span class="text-gray-500">Batas Pendaftaran:</span>
                <span class="font-bold text-maroon-700 tabular-nums">{formatDate(batch.tanggalTutup)}</span>
              </div>
              <div class="flex justify-between py-1.5 border-b border-gray-100">
                <span class="text-gray-500">Lokasi Penempatan:</span>
                <span class="font-bold text-gray-900">{data.lokasi}</span>
              </div>
              <div class="flex justify-between py-1.5">
                <span class="text-gray-500">Mode Kerja:</span>
                <span class="font-bold text-gray-900">{modeLabels[data.mode]}</span>
              </div>
            </div>

            <a
              href={`/pendaftaran/?jalur=${data.jalur}&posisi=${item.id}`}
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-maroon-700 hover:bg-maroon-800 text-white font-bold text-sm shadow-md shadow-maroon-900/10 transition-all group"
              data-track-event="klik_posisi_daftar"
              data-track-posisi={item.id}
              data-track-jalur={data.jalur}
            >
              <span>Daftar untuk Posisi Ini</span>
              <span class="w-5 h-5 rounded-full bg-white/20 flex items-center justify-center text-xs">↗</span>
            </a>

            <div class="mt-4 text-center">
              <a href="/posisi/" class="text-xs font-bold text-maroon-700 hover:underline transition-colors">
                ← Kembali ke Daftar Posisi
              </a>
            </div>
          </div>

          <div class="rounded-[24px] bg-gradient-to-br from-[#800020] to-[#5C0017] text-white p-6 shadow-md text-xs space-y-2.5">
            <strong class="text-white font-bold block text-sm">Pertanyaan Seputar Posisi Ini?</strong>
            <p class="text-maroon-100 leading-relaxed">
              Silakan hubungi admin sekretariat kami dengan menyebutkan judul posisi "{data.judul}".
            </p>
            <a
              href={`${siteConfig.whatsappUrl}&text=Halo%20Admin,%20saya%20ingin%20bertanya%20tentang%20posisi%20${encodeURIComponent(data.judul)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-bold text-white bg-white/15 hover:bg-white/25 px-4 py-2 rounded-full border border-white/20 transition-colors pt-1.5"
            >
              <span>Tanya via WhatsApp</span>
              <span>↗</span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CtaBanner
    title="Tertarik Bergabung di Posisi Ini?"
    subtitle="Siapkan seluruh kelengkapan dokumen persyaratan dan submit pendaftaran kamu sebelum batas batch ditutup."
  />
</BaseLayout>
