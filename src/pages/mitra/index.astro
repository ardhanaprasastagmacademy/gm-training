---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/ui/PageBanner.astro";
import MitraGrid from "../../components/sections/MitraGrid.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";
import { siteConfig } from "../../data/site";

const allMitra = await getCollection("mitra", ({ data }) => data.izinTayang);
const mitraList = allMitra.map((m) => ({
  slug: m.id,
  nama: m.data.nama,
  logo: m.data.logo,
  sektor: m.data.sektor,
  kota: m.data.kota,
  website: m.data.website,
  deskripsi: m.data.deskripsi || m.body,
}));

const mitraSchema = {
  "@type": "CollectionPage",
  "@id": `${siteConfig.url}/mitra/#webpage`,
  name: "Daftar Mitra Pendidikan & Kampus Rekanan Resmi",
  description:
    "Daftar mitra perguruan tinggi, politeknik, dan SMK resmi yang bekerja sama dalam Program Magang SMK & Mahasiswa Gemilang Training.",
  hasPart: mitraList.map((m) => ({
    "@type": "EducationalOrganization",
    name: m.nama.replace(/\s*\([^)]*\)/g, ""),
    url: m.website || `${siteConfig.url}/mitra/`,
    image: `${siteConfig.url}${m.logo}`,
    address: {
      "@type": "PostalAddress",
      addressLocality: m.kota,
      addressCountry: "ID",
    },
  })),
};
---

<BaseLayout
  title={`Mitra Pendidikan & Instansi Penempatan Magang | ${siteConfig.shortName}`}
  description="Daftar mitra perguruan tinggi, politeknik, dan sekolah menengah kejuruan resmi yang bekerja sama dalam Program Magang SMK & Mahasiswa Gemilang Training."
  schema={mitraSchema}
>
  <PageBanner
    title="Mitra Pendidikan & Instansi Rekanan"
    description="Kolaborasi nyata bersama perguruan tinggi dan sekolah kejuruan terkemuka untuk mencetak talenta muda yang kompeten dan siap kerja."
    breadcrumbs={[{ label: "Mitra Rekanan" }]}
    badge="Konsorsium Kemitraan Resmi"
  />

  <section class="py-14 md:py-20 bg-[#F8F9FA] text-gray-900">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-maroon-50 text-maroon-700 text-xs font-bold uppercase tracking-wider mb-3 border border-maroon-100">
          <span class="w-1.5 h-1.5 rounded-full bg-maroon-700"></span>
          <span>Jaringan Institusi Terverifikasi</span>
        </div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">
          Institusi &amp; Kampus Rekanan Resmi
        </h2>
        <p class="text-gray-600 text-sm md:text-base leading-relaxed mt-2">
          Seluruh mitra di bawah ini telah menjalin kesepakatan kemitraan dan mendukung lingkungan magang yang aman, edukatif, serta berstandar kurikulum industri.
        </p>
      </div>

      <!-- Partners Grid (Light theme) -->
      <MitraGrid mitraList={mitraList} showLinkToPositions={true} dark={false} />

      <!-- Detailed Partner Cards -->
      <div class="mt-16 pt-12 border-t border-gray-200/80 space-y-8">
        <div>
          <h3 class="text-xl md:text-2xl font-extrabold text-gray-900 mb-2">
            Profil Singkat Mitra Rekanan
          </h3>
          <p class="text-xs text-gray-500">
            Kenali profil kelembagaan, rumpun pendidikan vokasi, dan lokasi operasional institusi rekanan kami.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            mitraList.map((m) => (
              <div class="bg-white border border-gray-200/90 rounded-[24px] p-6 hover:shadow-md hover:border-maroon-300 transition-all duration-300 shadow-sm text-gray-900 flex flex-col justify-between">
                <div>
                  <div class="flex items-start gap-4">
                    <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gray-50 border border-gray-100 flex items-center justify-center p-2.5 shrink-0 shadow-xs">
                      <img
                        src={m.logo}
                        alt={`Logo resmi ${m.nama}`}
                        width="80"
                        height="80"
                        class="w-full h-full object-contain"
                        loading="lazy"
                      />
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center justify-between gap-2 flex-wrap">
                        <div class="font-extrabold text-base md:text-lg text-gray-900 leading-snug">
                          {m.nama.replace(/\s*\([^)]*\)/g, "")}
                        </div>
                        <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-gray-100 text-gray-700 font-semibold border border-gray-200">
                          {m.kota}
                        </span>
                      </div>
                      {m.sektor && (
                        <p class="text-xs text-maroon-700 font-medium mt-1">
                          {m.sektor}
                        </p>
                      )}
                    </div>
                  </div>

                  {m.deskripsi && (
                    <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mt-4 pt-3.5 border-t border-gray-100">
                      {m.deskripsi}
                    </p>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CtaBanner
    title="Siap Mengembangkan Kemampuan di Industri Rekanan Kami?"
    subtitle="Pilih posisi magang favorit kamu dan daftarkan diri pada batch yang sedang dibuka."
  />
</BaseLayout>
