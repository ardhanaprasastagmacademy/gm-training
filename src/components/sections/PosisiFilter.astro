---
interface Props {
  bidangList: string[];
}

const { bidangList } = Astro.props;
---

<div class="bg-white border border-gray-200/90 rounded-[24px] p-6 md:p-8 mb-10 shadow-sm text-gray-900" data-filter-root>
  <!-- Search input bar -->
  <div class="mb-6">
    <label for="posisi-search" class="block text-xs font-bold uppercase tracking-[0.2em] text-maroon-700 mb-2.5">
      Pencarian Posisi & Mitra
    </label>
    <div class="relative">
      <input
        type="search"
        id="posisi-search"
        placeholder="Cari judul posisi, nama mitra, kota, atau teknologi..."
        class="w-full h-12 pl-12 pr-4 rounded-full border border-gray-300 bg-gray-50/50 text-gray-900 placeholder:text-gray-400 text-sm focus:bg-white focus:border-maroon-600 focus:outline-none focus:ring-2 focus:ring-maroon-100 transition-all"
      />
      <svg class="w-5 h-5 text-gray-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path d="M21 21l-4.35-4.35" />
      </svg>
    </div>
  </div>

  <!-- Filter chips rows -->
  <div class="space-y-5 pt-5 border-t border-gray-100">
    <!-- Row 1: Jalur Peserta -->
    <div>
      <span class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2.5">
        Jalur Peserta:
      </span>
      <div class="flex flex-wrap gap-2" data-filter-group="jalur">
        <button
          type="button"
          data-filter-val="semua"
          class="filter-chip active inline-flex items-center gap-1.5 min-h-[38px] px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer border border-maroon-700 bg-maroon-700 text-white shadow-sm"
        >
          <svg class="w-3.5 h-3.5 check-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
          <span>Semua Jalur</span>
        </button>
        <button
          type="button"
          data-filter-val="smk"
          class="filter-chip inline-flex items-center gap-1.5 min-h-[38px] px-4 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer border border-gray-200 bg-gray-50 text-gray-700 hover:text-maroon-700 hover:bg-gray-100"
        >
          <span>Siswa SMK (PKL)</span>
        </button>
        <button
          type="button"
          data-filter-val="mahasiswa"
          class="filter-chip inline-flex items-center gap-1.5 min-h-[38px] px-4 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer border border-gray-200 bg-gray-50 text-gray-700 hover:text-maroon-700 hover:bg-gray-100"
        >
          <span>Mahasiswa (SKS)</span>
        </button>
      </div>
    </div>

    <!-- Row 2: Bidang -->
    {bidangList && bidangList.length > 0 && (
      <div>
        <span class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2.5">
          Bidang Keahlian:
        </span>
        <div class="flex flex-wrap gap-2" data-filter-group="bidang">
          <button
            type="button"
            data-filter-val="semua"
            class="filter-chip active inline-flex items-center gap-1.5 min-h-[38px] px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer border border-maroon-700 bg-maroon-700 text-white shadow-sm"
          >
            <svg class="w-3.5 h-3.5 check-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
            <span>Semua Bidang</span>
          </button>
          {bidangList.map((b) => (
            <button
              type="button"
              data-filter-val={b.toLowerCase()}
              class="filter-chip inline-flex items-center gap-1.5 min-h-[38px] px-4 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer border border-gray-200 bg-gray-50 text-gray-700 hover:text-maroon-700 hover:bg-gray-100"
            >
              <span>{b}</span>
            </button>
          ))}
        </div>
      </div>
    )}

    <!-- Row 3: Mode Kerja -->
    <div>
      <span class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-2.5">
        Mode Kerja:
      </span>
      <div class="flex flex-wrap gap-2" data-filter-group="mode">
        <button
          type="button"
          data-filter-val="semua"
          class="filter-chip active inline-flex items-center gap-1.5 min-h-[38px] px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer border border-maroon-700 bg-maroon-700 text-white shadow-sm"
        >
          <svg class="w-3.5 h-3.5 check-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
          <span>Semua Mode</span>
        </button>
        <button
          type="button"
          data-filter-val="onsite"
          class="filter-chip inline-flex items-center gap-1.5 min-h-[38px] px-4 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer border border-gray-200 bg-gray-50 text-gray-700 hover:text-maroon-700 hover:bg-gray-100"
        >
          <span>Di Lokasi (Onsite)</span>
        </button>
        <button
          type="button"
          data-filter-val="hybrid"
          class="filter-chip inline-flex items-center gap-1.5 min-h-[38px] px-4 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer border border-gray-200 bg-gray-50 text-gray-700 hover:text-maroon-700 hover:bg-gray-100"
        >
          <span>Gabungan (Hybrid)</span>
        </button>
        <button
          type="button"
          data-filter-val="remote"
          class="filter-chip inline-flex items-center gap-1.5 min-h-[38px] px-4 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer border border-gray-200 bg-gray-50 text-gray-700 hover:text-maroon-700 hover:bg-gray-100"
        >
          <span>Jarak Jauh (Remote)</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Live counter & Reset action -->
  <div class="mt-6 pt-5 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3 text-xs">
    <div aria-live="polite" id="filter-result-count" class="font-bold text-gray-900">
      Menampilkan semua posisi yang tersedia
    </div>

    <button
      type="button"
      id="reset-filter-btn"
      class="text-maroon-700 hover:text-maroon-800 font-bold hover:underline py-1 transition-colors cursor-pointer"
    >
      Atur Ulang Filter
    </button>
  </div>
</div>

<script>
  function setupPosisiFilter() {
    const root = document.querySelector<HTMLElement>("[data-filter-root]");
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = "true";

    const searchInput = document.getElementById("posisi-search") as HTMLInputElement;
    const resultCountEl = document.getElementById("filter-result-count");
    const resetBtn = document.getElementById("reset-filter-btn");
    const items = document.querySelectorAll<HTMLElement>("[data-posisi-item]");
    const emptyState = document.getElementById("posisi-empty-state");

    const state = {
      jalur: "semua",
      bidang: "semua",
      mode: "semua",
      search: "",
    };

    // Read initial URL params
    const params = new URLSearchParams(window.location.search);
    if (params.get("jalur")) state.jalur = params.get("jalur")!.toLowerCase();
    if (params.get("bidang")) state.bidang = params.get("bidang")!.toLowerCase();
    if (params.get("mode")) state.mode = params.get("mode")!.toLowerCase();
    if (params.get("cari")) {
      state.search = params.get("cari")!;
      if (searchInput) searchInput.value = state.search;
    }

    function syncChipStyles(groupName: string, selectedVal: string) {
      const group = root?.querySelector(`[data-filter-group="${groupName}"]`);
      if (!group) return;
      const chips = group.querySelectorAll<HTMLButtonElement>(".filter-chip");
      chips.forEach((chip) => {
        const val = chip.dataset.filterVal;
        const isSelected = val === selectedVal;
        if (isSelected) {
          chip.className =
            "filter-chip active inline-flex items-center gap-1.5 min-h-[38px] px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer border border-maroon-700 bg-maroon-700 text-white shadow-sm";
          if (!chip.querySelector(".check-icon")) {
            chip.insertAdjacentHTML(
              "afterbegin",
              '<svg class="w-3.5 h-3.5 check-icon" viewBox="0 0 16 16" fill="currentColor"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>'
            );
          }
        } else {
          chip.className =
            "filter-chip inline-flex items-center gap-1.5 min-h-[38px] px-4 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer border border-gray-200 bg-gray-50 text-gray-700 hover:text-maroon-700 hover:bg-gray-100";
          const icon = chip.querySelector(".check-icon");
          if (icon) icon.remove();
        }
      });
    }

    function applyFilter() {
      let visibleCount = 0;
      const q = state.search.toLowerCase().trim();

      items.forEach((item) => {
        const itemJalur = item.dataset.jalur || "keduanya";
        const itemBidang = item.dataset.bidang || "";
        const itemMode = item.dataset.mode || "";
        const itemText = item.textContent?.toLowerCase() || "";

        const matchJalur =
          state.jalur === "semua" ||
          itemJalur === "keduanya" ||
          itemJalur === state.jalur;

        const matchBidang = state.bidang === "semua" || itemBidang === state.bidang;

        const matchMode = state.mode === "semua" || itemMode === state.mode;

        const matchSearch = !q || itemText.includes(q);

        if (matchJalur && matchBidang && matchMode && matchSearch) {
          item.style.display = "";
          visibleCount++;
        } else {
          item.style.display = "none";
        }
      });

      // Update counter
      if (resultCountEl) {
        resultCountEl.textContent = `Menampilkan ${visibleCount} dari ${items.length} posisi yang sesuai kriteria`;
      }

      // Handle Empty State
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove("hidden");
        } else {
          emptyState.classList.add("hidden");
        }
      }

      // Update URL query parameters without page reload
      const newUrl = new URL(window.location.href);
      if (state.jalur && state.jalur !== "semua") newUrl.searchParams.set("jalur", state.jalur);
      else newUrl.searchParams.delete("jalur");

      if (state.bidang && state.bidang !== "semua") newUrl.searchParams.set("bidang", state.bidang);
      else newUrl.searchParams.delete("bidang");

      if (state.mode && state.mode !== "semua") newUrl.searchParams.set("mode", state.mode);
      else newUrl.searchParams.delete("mode");

      if (state.search) newUrl.searchParams.set("cari", state.search);
      else newUrl.searchParams.delete("cari");

      window.history.replaceState({}, "", newUrl.toString());
    }

    // Attach click handlers to chips
    root.querySelectorAll<HTMLButtonElement>(".filter-chip").forEach((chip) => {
      chip.addEventListener("click", () => {
        const group = chip.closest("[data-filter-group]")?.getAttribute("data-filter-group");
        const val = chip.dataset.filterVal || "semua";
        if (group === "jalur") state.jalur = val;
        if (group === "bidang") state.bidang = val;
        if (group === "mode") state.mode = val;

        syncChipStyles(group!, val);
        applyFilter();
      });
    });

    // Attach search input handler with debounce
    let timeoutId: any;
    searchInput?.addEventListener("input", (e) => {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => {
        state.search = (e.target as HTMLInputElement).value;
        applyFilter();
      }, 150);
    });

    // Reset button
    resetBtn?.addEventListener("click", () => {
      state.jalur = "semua";
      state.bidang = "semua";
      state.mode = "semua";
      state.search = "";
      if (searchInput) searchInput.value = "";
      syncChipStyles("jalur", "semua");
      syncChipStyles("bidang", "semua");
      syncChipStyles("mode", "semua");
      applyFilter();
    });

    // Initialize from URL state
    syncChipStyles("jalur", state.jalur);
    syncChipStyles("bidang", state.bidang);
    syncChipStyles("mode", state.mode);
    applyFilter();
  }

  setupPosisiFilter();
  document.addEventListener("astro:page-load", setupPosisiFilter);
</script>
