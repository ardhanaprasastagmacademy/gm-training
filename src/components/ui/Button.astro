---
interface Props {
  variant?: "primary" | "inverse" | "secondary" | "secondary-inverse" | "tertiary" | "disabled";
  size?: "default" | "hero" | "small";
  href?: string;
  target?: string;
  rel?: string;
  class?: string;
  disabled?: boolean;
  type?: "button" | "submit" | "reset";
  id?: string;
  [key: string]: any;
}

const {
  variant = "primary",
  size = "default",
  href,
  target,
  rel,
  class: className = "",
  disabled = false,
  type = "button",
  id,
  ...rest
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center font-bold text-center transition-all focus-visible:outline-2 focus-visible:outline-offset-2";

const sizeStyles = {
  small: "min-h-[42px] px-4 text-[0.875rem] rounded-full",
  default: "min-h-[46px] px-6 text-[0.9375rem] rounded-full",
  hero: "min-h-[52px] px-8 text-[1.0625rem] rounded-full",
};

const variantStyles = {
  primary:
    "bg-maroon-700 text-white hover:bg-maroon-600 focus-visible:outline-maroon-400 active:bg-maroon-800 shadow-md shadow-maroon-950/60",
  inverse:
    "bg-white text-maroon-900 hover:bg-gray-100 focus-visible:outline-white shadow-md",
  secondary:
    "bg-white/10 border border-white/20 text-white hover:bg-white/20 hover:border-maroon-400 focus-visible:outline-white",
  "secondary-inverse":
    "bg-transparent border border-white/30 text-white hover:bg-white/10 focus-visible:outline-white",
  tertiary:
    "min-h-[42px] px-0 bg-transparent text-maroon-300 underline underline-offset-4 hover:text-white focus-visible:outline-maroon-400",
  disabled:
    "bg-white/5 text-gray-500 border border-white/10 cursor-not-allowed pointer-events-none opacity-80",
};

const finalVariant = disabled ? "disabled" : variant;
const finalClass = `${baseStyles} ${sizeStyles[size]} ${variantStyles[finalVariant]} ${className}`.trim();
const resolvedRel = target === "_blank" ? (rel || "noopener noreferrer") : rel;
---

{
  href && !disabled ? (
    <a href={href} class={finalClass} target={target} rel={resolvedRel} id={id} {...rest}>
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={finalClass}
      disabled={disabled}
      aria-disabled={disabled ? "true" : undefined}
      id={id}
      {...rest}
    >
      <slot />
    </button>
  )
}
