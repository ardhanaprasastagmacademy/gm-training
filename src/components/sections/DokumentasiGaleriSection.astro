---
import { dataGaleri } from "../../data/galeri";

const items = dataGaleri;
---

<section id="dokumentasi-kegiatan" class="py-16 md:py-24 bg-[#F8F9FA] border-t border-gray-200/80">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-maroon-50 text-maroon-700 text-xs font-bold uppercase tracking-wider mb-3 border border-maroon-100">
        <span class="w-1.5 h-1.5 rounded-full bg-maroon-700"></span>
        <span>Portofolio &amp; Jejak Aktivitas</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight">
        Dokumentasi Kegiatan Magang
      </h2>
      <p class="text-gray-600 text-sm md:text-base leading-relaxed mt-3">
        Potret nyata bimbingan mentor praktisi, kolaborasi sprint antarmuka, hingga perayaan kelulusan peserta magang kami.
      </p>
    </div>

    <!-- Filter Tabs (Pills) -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-10" data-gallery-filter-tabs>
      <button
        type="button"
        data-filter="all"
        class="gallery-tab-btn active px-5 py-2 rounded-full text-xs md:text-sm font-semibold transition-all bg-maroon-700 text-white shadow-sm"
      >
        Semua
      </button>
      <button
        type="button"
        data-filter="mentoring"
        class="gallery-tab-btn px-5 py-2 rounded-full text-xs md:text-sm font-semibold transition-all bg-white text-gray-700 border border-gray-200 hover:bg-gray-50"
      >
        Mentoring Industri
      </button>
      <button
        type="button"
        data-filter="praktik"
        class="gallery-tab-btn px-5 py-2 rounded-full text-xs md:text-sm font-semibold transition-all bg-white text-gray-700 border border-gray-200 hover:bg-gray-50"
      >
        Praktik &amp; Kolaborasi
      </button>
      <button
        type="button"
        data-filter="orientasi"
        class="gallery-tab-btn px-5 py-2 rounded-full text-xs md:text-sm font-semibold transition-all bg-white text-gray-700 border border-gray-200 hover:bg-gray-50"
      >
        Orientasi &amp; Budaya Kerja
      </button>
      <button
        type="button"
        data-filter="presentasi"
        class="gallery-tab-btn px-5 py-2 rounded-full text-xs md:text-sm font-semibold transition-all bg-white text-gray-700 border border-gray-200 hover:bg-gray-50"
      >
        Presentasi &amp; Kelulusan
      </button>
    </div>

    <!-- Gallery Grid (Pure Photos matching reference) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-gallery-grid>
      {
        items.map((item) => (
          <a
            href="/galeri/"
            data-category={item.kategori}
            class="gallery-item group relative aspect-[4/3] rounded-[24px] overflow-hidden bg-gray-100 border border-gray-200/80 hover:border-maroon-700/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl shadow-sm block"
          >
            <img
              src={item.gambar}
              alt={item.judul}
              width="600"
              height="450"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />

            <!-- Subtle hover overlay with icon -->
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/35 transition-all duration-300 flex items-center justify-center">
              <div class="w-12 h-12 rounded-full bg-white/95 backdrop-blur-md text-maroon-800 flex items-center justify-center opacity-0 group-hover:opacity-100 scale-90 group-hover:scale-100 transition-all duration-300 shadow-xl">
                <span class="text-lg font-bold">↗</span>
              </div>
            </div>

            <!-- Category badge in corner -->
            <div class="absolute top-3.5 left-3.5 pointer-events-none">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-white/90 backdrop-blur-md text-maroon-900 border border-white/60 shadow-sm">
                {item.kategoriLabel}
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Bottom Action Pill -->
    <div class="mt-10 text-center">
      <a
        href="/galeri/"
        class="inline-flex items-center gap-2.5 px-7 py-3 rounded-full bg-white hover:bg-gray-50 text-maroon-800 font-bold text-sm border border-gray-200 shadow-sm hover:shadow-md transition-all group"
      >
        <span>Lihat Seluruh Galeri Dokumentasi</span>
        <span class="w-5 h-5 rounded-full bg-maroon-50 text-maroon-700 flex items-center justify-center text-xs group-hover:translate-x-0.5 transition-transform">
          →
        </span>
      </a>
    </div>
  </div>
</section>

<!-- Interactive tab filtering script -->
<script>
  function setupGalleryTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>(".gallery-tab-btn");
    const galleryItems = document.querySelectorAll<HTMLElement>(".gallery-item");

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetCategory = btn.dataset.filter;

        // Update active button state
        tabButtons.forEach((b) => {
          b.classList.remove("active", "bg-maroon-700", "text-white", "shadow-sm");
          b.classList.add("bg-white", "text-gray-700", "border", "border-gray-200");
        });
        btn.classList.add("active", "bg-maroon-700", "text-white", "shadow-sm");
        btn.classList.remove("bg-white", "text-gray-700", "border", "border-gray-200");

        // Filter cards
        galleryItems.forEach((card) => {
          const itemCat = card.dataset.category;
          if (targetCategory === "all" || itemCat === targetCategory) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  }

  setupGalleryTabs();
  document.addEventListener("astro:page-load", setupGalleryTabs);
</script>
