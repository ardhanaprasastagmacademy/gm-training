---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/ui/PageBanner.astro";
import PosisiFilter from "../../components/sections/PosisiFilter.astro";
import PosisiCard from "../../components/sections/PosisiCard.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";
import { siteConfig } from "../../data/site";

// Load all active positions
const allPosisi = await getCollection("posisi", ({ data }) => !data.draft);

// Get unique fields list for filter options
const bidangSet = new Set<string>();
allPosisi.forEach((p) => bidangSet.add(p.data.bidang));
const bidangList = Array.from(bidangSet);

// Prepare cards data
const posisiCards = await Promise.all(
  allPosisi.map(async (p) => {
    const mitraDoc = await getEntry("mitra", p.data.mitra.id);
    return {
      slug: p.id,
      judul: p.data.judul,
      mitraNama: mitraDoc ? mitraDoc.data.nama : "Mitra Industri",
      mitraLogo: mitraDoc ? mitraDoc.data.logo : undefined,
      jalur: p.data.jalur,
      bidang: p.data.bidang,
      lokasi: p.data.lokasi,
      mode: p.data.mode,
      durasiBulan: p.data.durasiBulan,
      kuotaAwal: p.data.kuotaAwal,
      ringkasan: p.body?.slice(0, 160) + "...",
    };
  })
);
---

<BaseLayout
  title={`Lowongan Magang SMK & Mahasiswa Batch 1 | ${siteConfig.shortName}`}
  description="Daftar lengkap lowongan magang dan PKL untuk siswa SMK dan mahasiswa: bidang teknologi informasi, otomasi manufaktur, desain kreatif, logistik, dan keuangan."
  canonical={`${siteConfig.url}/posisi/`}
>
  <PageBanner
    title="Lowongan & Posisi Magang Tersedia"
    description="Pilih penempatan magang yang sesuai dengan program keahlian kejuruan atau rumpun studi perkuliahan kamu."
    breadcrumbs={[{ label: "Posisi Magang" }]}
    badge="Penerimaan Batch 1"
  />

  <section class="py-14 md:py-20 bg-[#F8F9FA] text-gray-900">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Filter Controls -->
      <PosisiFilter bidangList={bidangList} />

      <!-- Posisi Grid with light theme -->
      <div id="posisi-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {posisiCards.map((p) => <PosisiCard {...p} dark={false} />)}
      </div>

      <!-- Empty State Container -->
      <div
        id="posisi-empty-state"
        class="hidden py-16 text-center border border-dashed border-gray-300 rounded-[24px] bg-white p-8 my-8 text-gray-900 shadow-sm"
      >
        <div class="w-14 h-14 rounded-full bg-maroon-50 border border-maroon-100 text-maroon-700 flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <path d="M21 21l-4.35-4.35" />
          </svg>
        </div>
        <h3 class="font-bold text-lg md:text-xl text-gray-900 mb-2">
          Tidak Ada Posisi yang Sesuai Kriteria
        </h3>
        <p class="text-xs md:text-sm text-gray-600 max-w-sm mx-auto mb-5 leading-relaxed">
          Coba atur ulang kata kunci pencarian kamu atau ubah pilihan filter jalur dan mode kerja.
        </p>
        <button
          id="empty-reset-btn"
          type="button"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-maroon-700 hover:bg-maroon-800 text-white font-bold text-xs shadow-sm transition-all cursor-pointer"
        >
          Atur Ulang Filter
        </button>
      </div>
    </div>
  </section>

  <CtaBanner
    title="Tidak Menemukan Jurusan yang Sesuai?"
    subtitle="Hubungi tim sekretariat kami untuk menanyakan rencana pembukaan posisi baru pada batch berikutnya."
    primaryText="Konsultasi via WhatsApp"
    primaryHref={siteConfig.whatsappUrl}
  />
</BaseLayout>

<script>
  function setupEmptyReset() {
    const emptyBtn = document.getElementById("empty-reset-btn");
    const resetBtn = document.getElementById("reset-filter-btn");
    emptyBtn?.addEventListener("click", () => {
      resetBtn?.click();
    });
  }

  setupEmptyReset();
  document.addEventListener("astro:page-load", setupEmptyReset);
</script>
