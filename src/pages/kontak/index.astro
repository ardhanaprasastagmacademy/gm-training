---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/ui/PageBanner.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";
import { siteConfig } from "../../data/site";
const contactSchema = {
  "@type": "ContactPage",
  "@id": `${siteConfig.url}/kontak/#webpage`,
  name: "Kontak Resmi Gemilang Training Malang",
  description:
    "Layanan informasi resmi WhatsApp, sekretariat kantor, dan konsultasi pendaftaran magang informatika di Kota Malang.",
  mainEntity: {
    "@type": "ContactPoint",
    contactType: "Customer Support & Admissions",
    telephone: siteConfig.whatsapp,
    email: siteConfig.email || "info@maganginformatika.web.id",
    areaServed: "ID",
    availableLanguage: ["id", "en"],
  },
};
---

<BaseLayout
  title={`Kontak Resmi Sekretariat Magang | ${siteConfig.shortName}`}
  description="Hubungi saluran resmi Program Magang SMK & Mahasiswa: layanan informasi WhatsApp resmi, alamat kantor sekretariat di Jl. Lowokwaru Malang, dan jam operasional pelayanan."
  schema={contactSchema}
>
  <PageBanner
    title="Kontak Resmi"
    description="Sampaikan pertanyaan seputar program magang, verifikasi persyaratan, atau rencana kerja sama institusi."
    breadcrumbs={[{ label: "Kontak" }]}
    badge="Saluran Layanan Terverifikasi"
  />

  <section class="py-14 md:py-20 bg-[#F8F9FA] text-gray-900">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <!-- Contact Channels Info (6 cols) -->
        <div class="lg:col-span-6 space-y-6">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-maroon-50 text-maroon-700 text-xs font-bold uppercase tracking-wider mb-3 border border-maroon-100">
              <span class="w-1.5 h-1.5 rounded-full bg-maroon-700"></span>
              <span>Layanan Terpadu</span>
            </div>
            <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-3 tracking-tight">
              Pusat Informasi & Layanan Publik
            </h2>
            <p class="text-gray-600 text-sm md:text-base leading-relaxed">
              Kami siap melayani calon peserta, guru/dosen pembimbing, serta perwakilan mitra industri melalui saluran komunikasi resmi berikut:
            </p>
          </div>

          <!-- Channel Cards -->
          <div class="space-y-4">
            <!-- WhatsApp -->
            <div class="bg-white border border-gray-200/90 rounded-[22px] p-5 flex items-start gap-4 transition-all duration-300 hover:shadow-md hover:border-emerald-300 shadow-sm">
              <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center shrink-0 mt-0.5 shadow-sm">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.031 2C6.495 2 2 6.496 2 12.032c0 1.954.561 3.82 1.624 5.432L2.094 22l4.675-1.503a9.98 9.98 0 0 0 5.262 1.535h.004c5.535 0 10.03-4.496 10.03-10.032 0-2.68-1.043-5.2-2.936-7.094A9.957 9.957 0 0 0 12.03 2zm5.856 14.184c-.244.686-1.42 1.309-1.956 1.393-.509.08-1.173.114-3.793-.97-2.235-.923-3.666-3.21-3.777-3.358-.112-.148-.905-1.205-.905-2.298 0-1.093.57-1.63.773-1.854.204-.224.448-.28.597-.28.149 0 .298.002.428.01.139.008.326-.053.509.387.189.453.647 1.579.704 1.693.057.114.095.248.019.398-.076.15-.114.244-.228.377-.114.133-.24.297-.343.398-.114.113-.233.236-.101.464.132.228.587.97 1.258 1.568.865.772 1.595 1.011 1.823 1.124.228.114.362.095.495-.057.133-.152.57-.664.722-.892.152-.228.305-.19.513-.114.208.076 1.32.622 1.549.736.228.114.38.17.437.266.057.095.057.551-.187 1.237z" />
                </svg>
              </div>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-gray-500 block mb-1">WhatsApp Resmi</span>
                <a
                  href={siteConfig.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-extrabold text-base text-gray-900 hover:text-emerald-600 hover:underline inline-flex items-center gap-1.5"
                >
                  <span>{siteConfig.whatsapp}</span>
                  <span class="text-xs text-gray-400">↗</span>
                </a>
                <p class="text-xs text-gray-600 mt-1">
                  Respon tercepat pada jam kerja Senin – Jumat, 08.00 – 17.00 WIB.
                </p>
              </div>
            </div>

            <!-- Instagram Resmi -->
            <div class="bg-white border border-gray-200/90 rounded-[22px] p-5 flex items-start gap-4 transition-all duration-300 hover:shadow-md hover:border-pink-300 shadow-sm">
              <div class="w-10 h-10 rounded-full bg-pink-50 text-pink-600 border border-pink-100 flex items-center justify-center shrink-0 mt-0.5 shadow-sm">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-gray-500 block mb-1">Instagram Resmi</span>
                <a
                  href={siteConfig.socials.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-extrabold text-base text-gray-900 hover:text-pink-600 hover:underline inline-flex items-center gap-1.5"
                >
                  <span>@gemilangtraining.id</span>
                  <span class="text-xs text-gray-400">↗</span>
                </a>
                <p class="text-xs text-gray-600 mt-1">
                  Dokumentasi kegiatan magang, testimoni alumni & pengumuman batch terbaru.
                </p>
              </div>
            </div>

            <!-- Jam Operasional -->
            <div class="bg-white border border-gray-200/90 rounded-[22px] p-5 flex items-start gap-4 transition-all duration-300 hover:shadow-md hover:border-maroon-300 shadow-sm">
              <div class="w-10 h-10 rounded-full bg-maroon-50 text-maroon-700 border border-maroon-100 flex items-center justify-center shrink-0 mt-0.5 shadow-sm">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
              </div>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-gray-500 block mb-1">Jam Operasional Layanan</span>
                <span class="font-extrabold text-base text-gray-900 block">
                  {siteConfig.officeHours}
                </span>
                <p class="text-xs text-gray-600 mt-1">
                  Konsultasi online via WhatsApp dan layanan kunjungan sekretariat.
                </p>
              </div>
            </div>

            <!-- Office Address -->
            <div class="bg-white border border-gray-200/90 rounded-[22px] p-5 flex items-start gap-4 transition-all duration-300 hover:shadow-md hover:border-maroon-300 shadow-sm">
              <div class="w-10 h-10 rounded-full bg-maroon-50 text-maroon-700 border border-maroon-100 flex items-center justify-center shrink-0 mt-0.5 shadow-sm">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </div>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-gray-500 block mb-1">Alamat Sekretariat</span>
                <address class="not-italic font-bold text-sm text-gray-900 leading-snug">
                  {siteConfig.address.street}<br />
                  {siteConfig.address.city}, {siteConfig.address.province} {siteConfig.address.postalCode}
                </address>
                <div class="mt-2">
                  <a
                    href="https://maps.google.com/?q=Jl.+Lowokwaru,+Kota+Malang"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-maroon-700 hover:underline inline-flex items-center gap-1"
                  >
                    <span>Buka Peta di Google Maps</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form / FAQ Check (6 cols) -->
        <div class="lg:col-span-6">
          <div class="bg-white border border-gray-200/90 rounded-[24px] p-6 md:p-8 shadow-sm text-gray-900">
            <h3 class="text-xl font-extrabold text-gray-900 mb-2">
              Kirim Pesan Cepat ke Admin
            </h3>
            <p class="text-xs text-gray-600 leading-relaxed mb-6">
              Isi data di bawah ini untuk mengirimkan pesan langsung ke tim sekretariat via WhatsApp resmi.
            </p>

            <form id="contact-form" class="space-y-4">
              <div>
                <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
                  Nama Lengkap <span class="text-maroon-700">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder="Contoh: Budi Santoso"
                  class="w-full h-12 px-4 rounded-xl border border-gray-300 bg-gray-50/50 text-sm text-gray-900 placeholder:text-gray-400 focus:bg-white focus:border-maroon-600 focus:outline-none focus:ring-2 focus:ring-maroon-100 transition-all"
                />
              </div>

              <div>
                <label for="contact-role" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
                  Status Anda <span class="text-maroon-700">*</span>
                </label>
                <select
                  id="contact-role"
                  required
                  class="w-full h-12 px-4 rounded-xl border border-gray-300 bg-gray-50/50 text-sm text-gray-900 focus:bg-white focus:border-maroon-600 focus:outline-none focus:ring-2 focus:ring-maroon-100 transition-all"
                >
                  <option value="Siswa SMK">Siswa SMK</option>
                  <option value="Mahasiswa">Mahasiswa</option>
                  <option value="Orang Tua / Wali">Orang Tua / Wali Siswa</option>
                  <option value="Guru / Dosen Pembimbing">Guru / Dosen Pembimbing</option>
                  <option value="Perwakilan Perusahaan">Perwakilan Perusahaan / Mitra</option>
                  <option value="Lainnya">Lainnya</option>
                </select>
              </div>

              <div>
                <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1.5">
                  Isi Pesan / Pertanyaan <span class="text-maroon-700">*</span>
                </label>
                <textarea
                  id="contact-message"
                  required
                  rows="4"
                  placeholder="Tuliskan pertanyaan atau informasi yang ingin dikonfirmasikan..."
                  class="w-full p-4 rounded-xl border border-gray-300 bg-gray-50/50 text-sm text-gray-900 placeholder:text-gray-400 focus:bg-white focus:border-maroon-600 focus:outline-none focus:ring-2 focus:ring-maroon-100 transition-all"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-maroon-700 hover:bg-maroon-800 text-white font-bold text-sm shadow-md shadow-maroon-900/10 transition-all cursor-pointer group"
                data-track-event="klik_kirim_pesan_kontak"
              >
                <span>Kirim via WhatsApp Resmi</span>
                <span class="w-5 h-5 rounded-full bg-white/20 flex items-center justify-center text-xs group-hover:translate-x-0.5 transition-transform">↗</span>
              </button>
            </form>

            <div class="mt-6 pt-4 border-t border-gray-100 text-xs text-gray-500">
              Sudah memeriksa halaman FAQ? Banyak pertanyaan umum telah kami jawab secara rinci di <a href="/faq/" class="text-maroon-700 font-bold hover:underline">Halaman Tanya Jawab</a>.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<script>
  function setupContactForm() {
    const form = document.getElementById("contact-form");
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = "true";

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const name = (document.getElementById("contact-name") as HTMLInputElement)?.value;
      const role = (document.getElementById("contact-role") as HTMLSelectElement)?.value;
      const msg = (document.getElementById("contact-message") as HTMLTextAreaElement)?.value;

      const fullText = `Halo Admin Gemilang Training, perkenalkan saya ${name} (${role}).%0A%0A${encodeURIComponent(msg)}`;
      const waUrl = `https://wa.me/6281943431484?text=${fullText}`;

      window.open(waUrl, "_blank", "noopener,noreferrer");
    });
  }

  setupContactForm();
  document.addEventListener("astro:page-load", setupContactForm);
</script>
