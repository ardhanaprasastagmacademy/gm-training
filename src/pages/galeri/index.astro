---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/ui/PageBanner.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";
import { dataGaleri } from "../../data/galeri";
import { siteConfig } from "../../data/site";

const categories = [
  { key: "semua", label: "Semua Dokumentasi" },
  { key: "mentoring", label: "Mentoring Industri" },
  { key: "praktik", label: "Praktik & Kolaborasi" },
  { key: "orientasi", label: "Orientasi & Budaya Kerja" },
  { key: "presentasi", label: "Presentasi & Kelulusan" },
];
---

<BaseLayout
  title={`Galeri Kegiatan & Dokumentasi Magang | ${siteConfig.shortName}`}
  description="Dokumentasi nyata aktivitas Praktik Kerja Lapangan (PKL) siswa SMK dan magang mahasiswa: bimbingan mentor industri, kolaborasi sprint, presentasi, dan pelepasan kelulusan."
>
  <PageBanner
    title="Galeri Kegiatan & Dokumentasi Magang"
    description="Potret pengalaman belajar, bimbingan mentor praktisi, dan kolaborasi peserta magang."
    breadcrumbs={[{ label: "Galeri Kegiatan" }]}
    badge="Dokumentasi Terverifikasi"
  />

  <section class="py-14 md:py-20 bg-[#F8F9FA] text-gray-900">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Category Filter Tabs (Pill style matching reference screenshot) -->
      <div class="mb-10 pb-6 border-b border-gray-200/80 flex flex-wrap gap-2.5" id="galeri-filters">
        {
          categories.map((c, idx) => (
            <button
              type="button"
              data-cat={c.key}
              class={`px-5 py-2 min-h-[38px] rounded-full text-xs font-bold transition-all cursor-pointer border ${
                idx === 0
                  ? "bg-maroon-700 text-white border-maroon-700 shadow-sm active-filter"
                  : "bg-white text-gray-700 border-gray-200 hover:bg-gray-100 hover:text-maroon-700"
              }`}
            >
              {c.label}
            </button>
          ))
        }
      </div>

      <!-- Photo Grid (Pure Photos matching reference) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="galeri-grid">
        {
          dataGaleri.map((item) => (
            <div
              data-galeri-item
              data-kategori={item.kategori}
              data-preview-img={item.gambar}
              data-preview-title={item.judul}
              data-preview-desc=""
              class="group relative aspect-[4/3] rounded-[24px] overflow-hidden bg-gray-100 border border-gray-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 cursor-pointer"
            >
              <img
                src={item.gambar}
                alt={item.judul}
                width="800"
                height="600"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />

              <!-- Subtle dark hover overlay with zoom icon -->
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/35 transition-all duration-300 flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-white/95 backdrop-blur-md text-maroon-800 flex items-center justify-center opacity-0 group-hover:opacity-100 scale-90 group-hover:scale-100 transition-all duration-300 shadow-xl">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                </div>
              </div>

              <!-- Category Badge Tag -->
              <div class="absolute top-3.5 left-3.5 pointer-events-none">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-white/90 backdrop-blur-md text-maroon-900 border border-white/60 shadow-sm">
                  {item.kategoriLabel}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Lightbox Modal Dialog (Light theme) -->
  <dialog
    id="galeri-lightbox"
    class="fixed inset-0 m-auto p-0 max-w-2xl w-[92vw] rounded-[24px] border border-gray-200 bg-white text-gray-900 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm z-50 overflow-hidden"
    aria-labelledby="lightbox-title"
  >
    <div class="relative bg-white">
      <div class="bg-gray-50 p-4 md:p-5 flex items-center justify-between text-gray-900 border-b border-gray-200">
        <h3 id="lightbox-title" class="text-sm md:text-base font-bold truncate pr-4 text-gray-900">Pratinjau Kegiatan</h3>
        <button
          type="button"
          id="close-lightbox"
          class="w-8 h-8 rounded-full bg-gray-200 text-gray-700 flex items-center justify-center hover:bg-gray-300 text-sm font-bold transition-colors cursor-pointer"
          aria-label="Tutup jendela pratinjau"
        >
          &times;
        </button>
      </div>

      <div class="p-4 md:p-5">
        <div class="aspect-[4/3] bg-gray-100 rounded-[18px] overflow-hidden border border-gray-200">
          <img id="lightbox-img" src="" alt="" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </dialog>

  <CtaBanner
    title="Ingin Menjadi Bagian dari Dokumentasi Berikutnya?"
    subtitle="Pendaftaran Batch 1 sedang dibuka. Daftarkan diri kamu sekarang dan rasakan pengalaman kerja nyata."
    primaryText="Daftar Sekarang"
    primaryHref="/pendaftaran/"
  />
</BaseLayout>

<script>
  function setupGaleri() {
    const filtersContainer = document.getElementById("galeri-filters");
    const items = document.querySelectorAll<HTMLElement>("[data-galeri-item]");
    const lightbox = document.getElementById("galeri-lightbox") as HTMLDialogElement;
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
    const lightboxTitle = document.getElementById("lightbox-title");
    const lightboxDesc = document.getElementById("lightbox-desc");
    const closeBtn = document.getElementById("close-lightbox");

    if (!filtersContainer || filtersContainer.dataset.initialized) return;
    filtersContainer.dataset.initialized = "true";

    // Category Tabs Filtering
    const buttons = filtersContainer.querySelectorAll<HTMLButtonElement>("button[data-cat]");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.cat;
        buttons.forEach((b) => {
          b.className =
            "px-5 py-2 min-h-[38px] rounded-full text-xs font-semibold transition-all cursor-pointer border bg-white text-gray-700 border-gray-200 hover:bg-gray-100 hover:text-maroon-700";
        });
        btn.className =
          "px-5 py-2 min-h-[38px] rounded-full text-xs font-bold transition-all cursor-pointer border bg-maroon-700 text-white border-maroon-700 shadow-sm active-filter";

        items.forEach((item) => {
          const itemCat = item.dataset.kategori;
          if (cat === "semua" || itemCat === cat) {
            item.style.display = "";
          } else {
            item.style.display = "none";
          }
        });
      });
    });

    // Lightbox modal preview triggers
    const previewTriggers = document.querySelectorAll<HTMLElement>("[data-preview-img]");
    previewTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        if (!lightbox) return;
        const src = trigger.dataset.previewImg || "";
        const title = trigger.dataset.previewTitle || "";
        const desc = trigger.dataset.previewDesc || "";

        if (lightboxImg) lightboxImg.src = src;
        if (lightboxTitle) lightboxTitle.textContent = title;
        if (lightboxDesc) lightboxDesc.textContent = desc;

        lightbox.showModal();
      });
    });

    closeBtn?.addEventListener("click", () => {
      lightbox?.close();
    });

    lightbox?.addEventListener("click", (e) => {
      if (e.target === lightbox) lightbox.close();
    });
  }

  setupGaleri();
  document.addEventListener("astro:page-load", setupGaleri);
</script>
