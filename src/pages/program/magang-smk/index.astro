---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageBanner from "../../../components/ui/PageBanner.astro";
import StepTimeline from "../../../components/sections/StepTimeline.astro";
import Accordion from "../../../components/ui/Accordion.astro";
import BidangKejuruanGrid from "../../../components/sections/BidangKejuruanGrid.astro";
import CtaBanner from "../../../components/sections/CtaBanner.astro";
import { siteConfig } from "../../../data/site";

// Fetch FAQ specifically for SMK track
const allFaq = await getCollection(
  "faq",
  ({ data }) => data.kategori === "smk" || data.kategori === "umum",
);
const smkFaqItems = allFaq.slice(0, 4).map((f) => ({
  id: f.id,
  title: f.data.pertanyaan,
  content: f.body || "",
}));
---

<BaseLayout
  title={`Program Magang Siswa SMK (PKL Industri) | ${siteConfig.shortName}`}
  description="Informasi resmi Praktik Kerja Lapangan (PKL) siswa SMK: persyaratan dokumen, surat izin orang tua, sistem bimbingan guru dan mentor industri."
>
  <PageBanner
    title="Program Magang Siswa SMK (PKL Industri)"
    description="Skema magang terstruktur yang diselaraskan dengan kurikulum kompetensi kejuruan SMK."
    breadcrumbs={[
      { label: "Program", href: "/program/" },
      { label: "Magang SMK" },
    ]}
    badge="Jalur Khusus Siswa SMK"
  />

  <section class="py-14 md:py-20 bg-[#F8F9FA] text-gray-900">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <!-- Main Content (8 cols) -->
        <div class="lg:col-span-8 space-y-10">
          <!-- Overview Card -->
          <div class="bg-white border border-gray-200/90 rounded-[24px] p-6 md:p-8 shadow-sm">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-maroon-50 text-maroon-700 text-xs font-bold uppercase tracking-wider mb-4 border border-maroon-100">
              <span class="w-1.5 h-1.5 rounded-full bg-maroon-700"></span>
              <span>Ikhtisar Program</span>
            </div>
            <h2 class="text-xl md:text-2xl font-extrabold text-gray-900 mb-5 tracking-tight">
              Ringkasan Program Praktik Kerja Lapangan (PKL)
            </h2>
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
              <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200/80">
                <dt class="font-bold text-xs uppercase tracking-wider text-maroon-700 mb-1">
                  Sasaran Siswa
                </dt>
                <dd class="font-bold text-gray-900">
                  Siswa SMK Kelas XI atau XII aktif
                </dd>
              </div>
              <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200/80">
                <dt class="font-bold text-xs uppercase tracking-wider text-maroon-700 mb-1">
                  Durasi Pelaksanaan
                </dt>
                <dd class="font-bold text-gray-900">
                  3 hingga 6 bulan (sesuai kalender sekolah)
                </dd>
              </div>
              <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200/80">
                <dt class="font-bold text-xs uppercase tracking-wider text-maroon-700 mb-1">
                  Jam Aktivitas
                </dt>
                <dd class="font-bold text-gray-900">
                  Maksimal 8 jam/hari (Senin–Jumat, tanpa lembur)
                </dd>
              </div>
              <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200/80">
                <dt class="font-bold text-xs uppercase tracking-wider text-maroon-700 mb-1">
                  Standar Keselamatan
                </dt>
                <dd class="font-bold text-gray-900">
                  Penyediaan APD lengkap & kepatuhan K3
                </dd>
              </div>
            </dl>
          </div>

          <!-- Requirements Checklist & Table -->
          <div>
            <div class="mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-maroon-700">Persyaratan</span>
              <h2 class="text-2xl font-extrabold text-gray-900 mt-1 tracking-tight">
                Persyaratan & Dokumen Wajib
              </h2>
            </div>
            <p class="text-gray-600 text-sm md:text-base mb-6 leading-relaxed">
              Semua berkas harus disiapkan dalam format digital (PDF atau pindaian foto yang jelas) sebelum mengisi formulir pendaftaran.
            </p>

            <div class="overflow-x-auto border border-gray-200/90 rounded-[24px] bg-white shadow-sm">
              <table class="w-full text-left text-sm text-gray-900">
                <thead class="bg-gray-50 text-gray-900 font-bold border-b border-gray-200">
                  <tr>
                    <th class="py-4 px-5">Dokumen</th>
                    <th class="py-4 px-5">Keterangan & Otoritas</th>
                    <th class="py-4 px-5">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-gray-700">
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <td class="py-4 px-5 font-bold text-gray-900">Surat Pengantar PKL dari Sekolah</td>
                    <td class="py-4 px-5">Ditandatangani oleh Kepala Sekolah, Waka Hubin, atau Koordinator BKK SMK</td>
                    <td class="py-4 px-5">
                      <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-bold bg-maroon-50 text-maroon-700 border border-maroon-100">
                        Wajib
                      </span>
                    </td>
                  </tr>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <td class="py-4 px-5 font-bold text-gray-900">Surat Izin Orang Tua / Wali</td>
                    <td class="py-4 px-5">Format resmi persetujuan orang tua/wali bagi siswa di bawah 18 tahun</td>
                    <td class="py-4 px-5">
                      <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-bold bg-maroon-50 text-maroon-700 border border-maroon-100">
                        Wajib
                      </span>
                    </td>
                  </tr>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <td class="py-4 px-5 font-bold text-gray-900">Curriculum Vitae (CV) Siswa</td>
                    <td class="py-4 px-5">Memuat jurusan, daftar praktikum bengkel/lab, dan keahlian software/tools</td>
                    <td class="py-4 px-5">
                      <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-bold bg-maroon-50 text-maroon-700 border border-maroon-100">
                        Wajib
                      </span>
                    </td>
                  </tr>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <td class="py-4 px-5 font-bold text-gray-900">Transkrip Nilai / Rapor Terakhir</td>
                    <td class="py-4 px-5">Nilai mata pelajaran kejuruan minimal semester terakhir</td>
                    <td class="py-4 px-5">
                      <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-bold bg-maroon-50 text-maroon-700 border border-maroon-100">
                        Wajib
                      </span>
                    </td>
                  </tr>
                  <tr class="hover:bg-gray-50/60 transition-colors">
                    <td class="py-4 px-5 font-bold text-gray-900">Portofolio Karya / Proyek Sekolah</td>
                    <td class="py-4 px-5">Tautan foto karya bengkel, repositori coding, atau file desain visual</td>
                    <td class="py-4 px-5">
                      <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                        Nilai Tambah
                      </span>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="mt-4 flex items-center gap-2 text-xs text-gray-600">
              <svg class="w-4 h-4 text-maroon-700 shrink-0" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 3a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm1 4v4H7V8h2z"></path>
              </svg>
              <span>
                Belum punya format surat izin? Unduh template resmi di{" "}
                <a href="/unduhan/" class="text-maroon-700 font-bold hover:underline">
                  Pusat Unduhan Dokumen
                </a>.
              </span>
            </div>
          </div>

          <!-- Dual Mentorship System -->
          <div>
            <div class="mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-maroon-700">Pembimbingan</span>
              <h2 class="text-2xl font-extrabold text-gray-900 mt-1 tracking-tight">
                Sistem Bimbingan Ganda (Sekolah & Industri)
              </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="bg-white border border-gray-200/90 rounded-[22px] p-6 shadow-sm">
                <div class="w-10 h-10 rounded-full bg-maroon-50 text-maroon-700 border border-maroon-100 flex items-center justify-center font-bold text-sm mb-4">
                  G
                </div>
                <h3 class="font-bold text-lg text-gray-900 mb-2">
                  Guru Pembimbing Sekolah
                </h3>
                <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
                  Bertugas mengawasi perkembangan akademik siswa, melakukan monitoring berkala ke mitra penempatan, dan memberikan penilaian sinkronisasi kurikulum.
                </p>
              </div>

              <div class="bg-white border border-gray-200/90 rounded-[22px] p-6 shadow-sm">
                <div class="w-10 h-10 rounded-full bg-maroon-50 text-maroon-700 border border-maroon-100 flex items-center justify-center font-bold text-sm mb-4">
                  M
                </div>
                <h3 class="font-bold text-lg text-gray-900 mb-2">
                  Mentor Pembimbing Industri
                </h3>
                <p class="text-xs md:text-sm text-gray-600 leading-relaxed">
                  Praktisi profesional di tempat magang yang memberikan arahan teknis harian, memeriksa logbook mingguan, dan mengevaluasi kedisiplinan kerja.
                </p>
              </div>
            </div>
          </div>

          <!-- Timeline Alur Khusus SMK -->
          <div>
            <div class="mb-5">
              <span class="text-xs font-bold uppercase tracking-wider text-maroon-700">Tahapan Proses</span>
              <h2 class="text-2xl font-extrabold text-gray-900 mt-1 tracking-tight">
                Tahapan Alur Pendaftaran Siswa SMK
              </h2>
            </div>
            <StepTimeline filterJalur="smk" />
          </div>

          <!-- FAQ Jalur SMK -->
          <div>
            <div class="mb-5">
              <span class="text-xs font-bold uppercase tracking-wider text-maroon-700">Tanya Jawab</span>
              <h2 class="text-2xl font-extrabold text-gray-900 mt-1 tracking-tight">
                Pertanyaan Khusus Siswa SMK
              </h2>
            </div>
            <Accordion items={smkFaqItems} />
          </div>
        </div>

        <!-- Sticky Sidebar CTA (4 cols) -->
        <aside class="lg:col-span-4 sticky top-24 space-y-6">
          <div class="bg-white border border-gray-200/90 rounded-[24px] p-6 shadow-sm">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-maroon-50 text-maroon-700 border border-maroon-100 mb-4 uppercase">
              Pendaftaran Aktif
            </span>
            <h3 class="font-extrabold text-xl text-gray-900 mb-2">
              Daftar Praktik Kerja Lapangan
            </h3>
            <p class="text-xs text-gray-600 mb-6 leading-relaxed">
              Pastikan kamu telah mengantongi surat izin orang tua dan surat rekomendasi sekolah sebelum mengisi formulir.
            </p>
            <a
              href="/pendaftaran/?jalur=smk"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-maroon-700 hover:bg-maroon-800 text-white font-bold text-sm shadow-md shadow-maroon-900/10 transition-all group"
              data-track-event="klik_program_smk_daftar"
              data-track-jalur="smk"
            >
              <span>Daftar sebagai Siswa SMK</span>
              <span class="w-5 h-5 rounded-full bg-white/20 flex items-center justify-center text-xs">↗</span>
            </a>

            <div class="mt-4 text-center">
              <a
                href="/posisi/?jalur=smk"
                class="text-xs font-bold text-maroon-700 hover:underline transition-colors"
              >
                Lihat Khusus Posisi Siswa SMK →
              </a>
            </div>
          </div>

          <div class="rounded-[24px] bg-gradient-to-br from-[#800020] to-[#5C0017] text-white p-6 shadow-md">
            <h4 class="font-bold text-white text-base mb-2">
              Untuk Guru BKK / Hubin SMK
            </h4>
            <p class="text-xs text-maroon-100 leading-relaxed mb-4">
              Ingin menjalin MoU penempatan berkala rombongan belajar sekolah kamu bersama konsorsium industri kami?
            </p>
            <a
              href="/untuk-sekolah-kampus/"
              class="inline-flex items-center gap-2 text-xs font-bold text-white bg-white/15 hover:bg-white/25 px-4 py-2 rounded-full border border-white/20 transition-colors w-full justify-between"
            >
              <span>Pelajari Prosedur Kerja Sama</span>
              <span>↗</span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Pilihan Program & Bidang Kejuruan PKL -->
  <BidangKejuruanGrid />

  <CtaBanner
    title="Siap Mengikuti PKL di Industri Rekanan Kami?"
    subtitle="Konsultasikan posisi yang sesuai dengan kejuruan sekolah kamu bersama tim sekretariat."
    primaryText="Pilih Posisi SMK"
    primaryHref="/posisi/?jalur=smk"
  />
</BaseLayout>
