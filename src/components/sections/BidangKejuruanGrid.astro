---

<section id="program-unggulan" class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
  <!-- Header Section -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end mb-10 pb-6 border-b border-gray-200">
    <div class="md:col-span-7">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-maroon-50 text-maroon-700 text-xs font-bold uppercase tracking-wider mb-3 border border-maroon-100">
        <span class="w-1.5 h-1.5 rounded-full bg-maroon-700"></span>
        <span>{badge}</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight">
        {title}
      </h2>
    </div>
    <div class="md:col-span-5">
      <p class="text-sm md:text-base text-gray-600 leading-relaxed">
        {subtitle}
      </p>
    </div>
  </div>

  <!-- Category Filter Pills -->
  {
    showFilters && (
      <div class="flex flex-wrap items-center gap-2 mb-10" data-program-filters>
        <button
          type="button"
          data-filter="all"
          class="program-filter-btn active px-5 py-2 rounded-full text-xs md:text-sm font-semibold transition-all bg-maroon-700 text-white shadow-sm"
        >
          Semua Program ({bidangList.length})
        </button>
        <button
          type="button"
          data-filter="software"
          class="program-filter-btn px-5 py-2 rounded-full text-xs md:text-sm font-semibold transition-all bg-white text-gray-700 border border-gray-200 hover:bg-gray-50"
        >
          Software &amp; Web
        </button>
        <button
          type="button"
          data-filter="network"
          class="program-filter-btn px-5 py-2 rounded-full text-xs md:text-sm font-semibold transition-all bg-white text-gray-700 border border-gray-200 hover:bg-gray-50"
        >
          Jaringan &amp; Cloud
        </button>
        <button
          type="button"
          data-filter="data-iot"
          class="program-filter-btn px-5 py-2 rounded-full text-xs md:text-sm font-semibold transition-all bg-white text-gray-700 border border-gray-200 hover:bg-gray-50"
        >
          Data, AI &amp; IoT
        </button>
        <button
          type="button"
          data-filter="design"
          class="program-filter-btn px-5 py-2 rounded-full text-xs md:text-sm font-semibold transition-all bg-white text-gray-700 border border-gray-200 hover:bg-gray-50"
        >
          Desain &amp; Produk Digital
        </button>
      </div>
    )
  }

  <!-- 3 Columns Grid Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="program-cards-container">
    {
      bidangList.map((bidang) => (
        <a
          href={bidang.link}
          data-category={bidang.category}
          class="program-card-item bg-white rounded-[24px] border border-gray-200/80 overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group"
        >
          <!-- Photo on Top -->
          <div class="aspect-[16/10] w-full overflow-hidden bg-gray-100 relative">
            <img
              src={bidang.gambar}
              alt={bidang.judul}
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
            />
            <div class="absolute top-3 left-3">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-white/90 backdrop-blur-md text-maroon-800 shadow-sm border border-white/60">
                {bidang.tag}
              </span>
            </div>
          </div>

          <!-- Content Below -->
          <div class="p-6 flex flex-col justify-between flex-1">
            <div>
              <h3 class="text-lg md:text-xl font-bold text-gray-900 group-hover:text-maroon-700 transition-colors leading-snug mb-2">
                {bidang.judul}
              </h3>
              <p class="text-xs md:text-sm text-gray-600 leading-relaxed line-clamp-2 mb-4">
                {bidang.deskripsi}
              </p>

              <!-- Skills Badges -->
              <div class="flex flex-wrap gap-1.5">
                {bidang.skills.map((skill) => (
                  <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-gray-100 text-gray-700 border border-gray-200/60">
                    {skill}
                  </span>
                ))}
              </div>
            </div>

            <!-- Bottom Row with Circular Arrow Button -->
            <div class="pt-4 mt-5 border-t border-gray-100 flex items-center justify-between">
              <span class="text-xs font-bold text-gray-500 group-hover:text-maroon-700 transition-colors">
                Daftar Program
              </span>
              <span class="w-9 h-9 rounded-full bg-maroon-700 group-hover:bg-maroon-800 text-white flex items-center justify-center font-bold text-sm shadow-sm transition-transform duration-200 group-hover:scale-105">
                ↗
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <!-- Bottom CTA Link -->
  <div class="mt-12 text-center">
    <a
      href="/pendaftaran/form/"
      class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full bg-white hover:bg-gray-50 text-maroon-800 font-bold text-sm border border-gray-200 shadow-sm hover:shadow-md transition-all group"
    >
      <span>Daftar Program Magang Sekarang</span>
      <span class="w-5 h-5 rounded-full bg-maroon-50 text-maroon-700 flex items-center justify-center text-xs group-hover:translate-x-0.5 transition-transform">
        →
      </span>
    </a>
  </div>
</section>

<!-- Interactive Category Filtering Script -->
<script>
  function setupProgramFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".program-filter-btn");
    const programCards = document.querySelectorAll<HTMLElement>(".program-card-item");

    if (!filterButtons.length || !programCards.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetCategory = btn.dataset.filter;

        // Toggle active button styles
        filterButtons.forEach((b) => {
          b.classList.remove("active", "bg-maroon-700", "text-white", "shadow-sm");
          b.classList.add("bg-white", "text-gray-700", "border", "border-gray-200");
        });
        btn.classList.add("active", "bg-maroon-700", "text-white", "shadow-sm");
        btn.classList.remove("bg-white", "text-gray-700", "border", "border-gray-200");

        // Filter cards
        programCards.forEach((card) => {
          const itemCat = card.dataset.category;
          if (targetCategory === "all" || itemCat === targetCategory) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  }

  setupProgramFilters();
  document.addEventListener("astro:page-load", setupProgramFilters);
</script>
