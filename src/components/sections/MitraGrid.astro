---
interface MitraItem {
  slug: string;
  nama: string;
  logo: string;
  sektor: string;
  kota?: string;
  website?: string;
  deskripsi?: string;
}

interface Props {
  mitraList: MitraItem[];
  showLinkToPositions?: boolean;
  dark?: boolean;
  class?: string;
}

const {
  mitraList,
  class: className = "",
} = Astro.props;
---

<div class={`grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-5 sm:gap-6 lg:gap-8 items-start justify-center ${className}`}>
  {
    mitraList.map((m) => (
      <a
        href="/mitra/"
        class="group flex flex-col items-center text-center p-2.5 rounded-2xl transition-all duration-300 focus-visible:outline-2 focus-visible:outline-maroon-700"
      >
        <!-- Logo Mitra (Clean emblem in white container) -->
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white border border-gray-200/80 shadow-xs flex items-center justify-center p-2 mb-3 transition-all duration-300 group-hover:-translate-y-1.5 group-hover:scale-105 group-hover:shadow-md group-hover:border-maroon-300">
          <img
            src={m.logo}
            alt={`Logo resmi ${m.nama}`}
            width="80"
            height="80"
            class="w-12 h-12 sm:w-14 sm:h-14 object-contain filter group-hover:brightness-105 transition-all duration-300"
            loading="lazy"
          />
        </div>

        <!-- Nama Mitra -->
        <h3 class="font-bold text-xs sm:text-sm text-gray-900 group-hover:text-maroon-700 transition-colors duration-200 leading-snug">
          {m.nama.replace(/\s*\([^)]*\)/g, "")}
        </h3>
      </a>
    ))
  }
</div>
