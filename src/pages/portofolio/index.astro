---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/ui/PageBanner.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";
import { dataPortofolio } from "../../data/portofolio";
import { siteConfig } from "../../data/site";

const categories = [
  { key: "all", label: "Semua Kategori" },
  { key: "pelatihan", label: "Vokasi & Pelatihan" },
  { key: "web-dev", label: "Web & FinTech" },
  { key: "marketing", label: "Media & Digital Marketing" },
  { key: "branding", label: "Branding & Merchandise" },
];
---

<BaseLayout
  title={`Portofolio Dokumentasi Karya | ${siteConfig.shortName}`}
  description="Dokumentasi portofolio hasil karya, proyek digital, dan aktivitas program pelatihan serta magang industri di Gemilang Training Malang."
>
  <PageBanner
    title="Portofolio Dokumentasi Karya"
    description="Dokumentasi visual proyek nyata, pelatihan industri, dan luaran terapan bersama mitra institusi dan korporasi."
    breadcrumbs={[{ label: "Portofolio" }]}
    badge="Dokumentasi Portofolio"
  />

  <section class="py-14 md:py-20 bg-[#F8F9FA] text-gray-900">
    <div class="max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="max-w-3xl mx-auto text-center mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-maroon-50 text-maroon-700 text-xs font-bold uppercase tracking-wider mb-3 border border-maroon-100">
          <span class="w-1.5 h-1.5 rounded-full bg-maroon-700"></span>
          <span>Proyek &amp; Luaran Nyata</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">
          Portofolio Aktivitas &amp; Karya Terapan
        </h2>
        <p class="text-gray-600 text-sm md:text-base leading-relaxed mt-3">
          Dokumentasi komprehensif implementasi teknologi, pelatihan kejuruan vokasi, dan luaran kerja sama industri di Gemilang Training.
        </p>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-2 md:gap-3 mb-12" id="portfolio-filters">
        {
          categories.map((cat, idx) => (
            <button
              type="button"
              data-filter={cat.key}
              class={`filter-btn px-4 sm:px-5 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer border ${
                idx === 0
                  ? "bg-maroon-800 text-white border-maroon-800 shadow-sm active-filter"
                  : "bg-white text-gray-700 border-gray-200 hover:border-maroon-300 hover:text-maroon-800 shadow-xs"
              }`}
            >
              {cat.label}
            </button>
          ))
        }
      </div>

      <!-- Portfolio Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 md:gap-8" id="portfolio-grid">
        {
          dataPortofolio.map((item) => (
            <article
              class="portfolio-card group bg-white border border-gray-200/90 rounded-[28px] overflow-hidden shadow-sm hover:shadow-xl hover:border-maroon-300 transition-all duration-300 flex flex-col justify-between"
              data-category={item.kategori}
            >
              <div>
                <!-- Image Container with Aspect Ratio and Lightbox Trigger -->
                <div
                  class="relative aspect-[16/10] overflow-hidden bg-gray-100 cursor-pointer"
                  data-lightbox-trigger
                  data-img={item.gambar}
                  data-title={item.judul}
                  data-desc={item.deskripsi}
                  data-client={item.klien}
                  data-location={item.lokasi}
                  data-output={item.luaran}
                  data-tags={JSON.stringify(item.techStack)}
                >
                  <img
                    src={item.gambar}
                    alt={item.judul}
                    width="800"
                    height="500"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                  <!-- Gradient Overlay & Hover Pill -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                    <div class="px-4 py-2 rounded-full bg-white/95 backdrop-blur-md text-maroon-900 text-xs font-bold shadow-lg flex items-center gap-1.5 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                      <span>Perbesar Foto</span>
                      <span class="text-sm">↗</span>
                    </div>
                  </div>

                  <!-- Category Badge on Image -->
                  <div class="absolute top-3.5 left-3.5 z-10">
                    <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-white/95 backdrop-blur-md text-maroon-800 shadow-sm border border-white/60">
                      {item.kategoriLabel}
                    </span>
                  </div>
                </div>

                <!-- Text Content & Description -->
                <div class="p-6">
                  <!-- Client / Partner Tag -->
                  <div class="flex items-center justify-between text-xs text-gray-500 mb-2 gap-2">
                    <span class="font-semibold text-maroon-700 flex items-center gap-1.5 truncate">
                      <svg class="w-3.5 h-3.5 shrink-0 fill-current" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd" />
                      </svg>
                      {item.klien}
                    </span>
                    <span class="shrink-0 text-gray-400">&bull; {item.lokasi}</span>
                  </div>

                  <!-- Project Title -->
                  <h3 class="font-extrabold text-lg sm:text-xl text-gray-900 group-hover:text-maroon-800 transition-colors duration-200 leading-snug mb-3">
                    {item.judul}
                  </h3>

                  <!-- Tailored Description matching project -->
                  <p class="text-gray-600 text-xs sm:text-sm leading-relaxed mb-4">
                    {item.deskripsi}
                  </p>

                  <!-- Tech Stack / Deliverable Tags -->
                  <div class="flex flex-wrap gap-1.5 pt-2 border-t border-gray-100">
                    {item.techStack.map((tech) => (
                      <span class="px-2.5 py-0.5 rounded-md bg-gray-100 text-gray-700 text-[11px] font-medium border border-gray-200/80">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Card Footer Action -->
              <div class="px-6 pb-6 pt-2">
                <button
                  type="button"
                  data-lightbox-trigger
                  data-img={item.gambar}
                  data-title={item.judul}
                  data-desc={item.deskripsi}
                  data-client={item.klien}
                  data-location={item.lokasi}
                  data-output={item.luaran}
                  data-tags={JSON.stringify(item.techStack)}
                  class="w-full py-2.5 px-4 rounded-xl bg-gray-50 hover:bg-maroon-50 text-gray-700 hover:text-maroon-800 text-xs sm:text-sm font-bold border border-gray-200/90 hover:border-maroon-200 transition-all flex items-center justify-center gap-1.5 cursor-pointer"
                >
                  <span>Lihat Detail Portofolio</span>
                  <span class="text-xs">→</span>
                </button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Interactive Portfolio Detail / Lightbox Modal -->
  <dialog
    id="portfolio-modal"
    class="fixed inset-0 m-auto p-0 max-w-3xl w-[94vw] rounded-[28px] border-0 bg-transparent text-gray-900 shadow-2xl backdrop:bg-black/80 backdrop:backdrop-blur-sm z-50 overflow-hidden"
  >
    <div class="relative bg-white rounded-[28px] overflow-hidden shadow-2xl flex flex-col max-h-[92vh]">
      <!-- Close Button -->
      <button
        type="button"
        id="close-modal"
        class="absolute top-3 right-3 z-30 w-9 h-9 rounded-full bg-black/60 hover:bg-black/80 text-white flex items-center justify-center text-xl font-bold transition-colors cursor-pointer"
        aria-label="Tutup Dialog"
      >
        &times;
      </button>

      <!-- Scrollable Container -->
      <div class="overflow-y-auto">
        <!-- Full Image Area -->
        <div class="relative w-full aspect-[16/10] sm:aspect-[16/9] bg-black/5 flex items-center justify-center overflow-hidden">
          <img
            id="modal-img"
            src=""
            alt="Portofolio Detail"
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Detail Content -->
        <div class="p-6 sm:p-8 space-y-4">
          <div class="flex items-center gap-2 text-xs font-semibold text-maroon-700">
            <span id="modal-client"></span>
            <span class="text-gray-300">&bull;</span>
            <span id="modal-location" class="text-gray-500 font-normal"></span>
          </div>

          <h3 id="modal-title" class="text-xl sm:text-2xl font-extrabold text-gray-900 leading-snug">
          </h3>

          <p id="modal-desc" class="text-gray-600 text-sm sm:text-base leading-relaxed">
          </p>

          <div class="pt-3 border-t border-gray-100">
            <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">
              Luaran Proyek:
            </div>
            <div id="modal-output" class="text-sm font-semibold text-gray-800"></div>
          </div>

          <div class="pt-2">
            <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">
              Kompetensi &amp; Perangkat:
            </div>
            <div id="modal-tags" class="flex flex-wrap gap-1.5"></div>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  <CtaBanner
    title="Ingin Membangun Portofolio Nyata Seperti Ini?"
    subtitle="Program Magang Informatika di Kota Malang membuka kesempatan bagi siswa SMK dan mahasiswa untuk mengerjakan proyek langsung bersama mentor industri."
    primaryText="Daftar Sekarang"
    primaryHref="/pendaftaran/"
  />
</BaseLayout>

<script>
  function setupPortfolioInteractions() {
    // 1. Category Filtering
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".portfolio-card");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter || "all";

        // Update active button styling
        filterButtons.forEach((b) => {
          b.classList.remove("bg-maroon-800", "text-white", "border-maroon-800", "active-filter");
          b.classList.add("bg-white", "text-gray-700", "border-gray-200");
        });
        btn.classList.remove("bg-white", "text-gray-700", "border-gray-200");
        btn.classList.add("bg-maroon-800", "text-white", "border-maroon-800", "active-filter");

        // Filter cards
        cards.forEach((card) => {
          const category = card.dataset.category;
          if (filter === "all" || category === filter) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      });
    });

    // 2. Lightbox / Detail Modal
    const modal = document.getElementById("portfolio-modal") as HTMLDialogElement | null;
    const modalImg = document.getElementById("modal-img") as HTMLImageElement | null;
    const modalTitle = document.getElementById("modal-title");
    const modalDesc = document.getElementById("modal-desc");
    const modalClient = document.getElementById("modal-client");
    const modalLocation = document.getElementById("modal-location");
    const modalOutput = document.getElementById("modal-output");
    const modalTags = document.getElementById("modal-tags");
    const closeBtn = document.getElementById("close-modal");
    const triggers = document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]");

    if (!modal || !triggers.length) return;

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const img = trigger.dataset.img || "";
        const title = trigger.dataset.title || "";
        const desc = trigger.dataset.desc || "";
        const client = trigger.dataset.client || "";
        const location = trigger.dataset.location || "";
        const output = trigger.dataset.output || "";
        let tags: string[] = [];
        try {
          tags = JSON.parse(trigger.dataset.tags || "[]");
        } catch {
          tags = [];
        }

        if (modalImg) modalImg.src = img;
        if (modalTitle) modalTitle.textContent = title;
        if (modalDesc) modalDesc.textContent = desc;
        if (modalClient) modalClient.textContent = client;
        if (modalLocation) modalLocation.textContent = location;
        if (modalOutput) modalOutput.textContent = output;

        if (modalTags) {
          modalTags.innerHTML = "";
          tags.forEach((tag) => {
            const span = document.createElement("span");
            span.className = "px-2.5 py-0.5 rounded-md bg-gray-100 text-gray-700 text-xs font-medium border border-gray-200";
            span.textContent = tag;
            modalTags.appendChild(span);
          });
        }

        modal.showModal();
      });
    });

    closeBtn?.addEventListener("click", () => modal.close());

    modal.addEventListener("click", (e) => {
      const rect = modal.getBoundingClientRect();
      const isInDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width;
      if (!isInDialog) {
        modal.close();
      }
    });
  }

  setupPortfolioInteractions();
  document.addEventListener("astro:page-load", setupPortfolioInteractions);
</script>
