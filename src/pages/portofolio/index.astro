---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageBanner from "../../components/ui/PageBanner.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";
import { siteConfig } from "../../data/site";

const portoImages = [
  "/images/portofolio/porto-1.webp",
  "/images/portofolio/porto-2.webp",
  "/images/portofolio/porto-3.webp",
  "/images/portofolio/porto-4.webp",
  "/images/portofolio/porto-5.webp",
];
---

<BaseLayout
  title={`Portofolio Dokumentasi Karya | ${siteConfig.shortName}`}
  description="Dokumentasi portofolio hasil karya dan aktivitas program magang industri di Gemilang Training Malang."
>
  <PageBanner
    title="Portofolio Dokumentasi Karya"
    description="Dokumentasi visual hasil karya, proyek digital, dan aktivitas magang industri terstruktur."
    breadcrumbs={[{ label: "Portofolio" }]}
    badge="Dokumentasi Visual"
  />

  <!-- Pure Image Portfolio Section (Menampilkan gambar saja tanpa penjelasan apa-apa) -->
  <section class="py-14 md:py-20 bg-[#F8F9FA] text-gray-900">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="portofolio-grid">
        {
          portoImages.map((img, idx) => (
            <div
              class="group relative aspect-[4/3] rounded-[24px] overflow-hidden bg-gray-100 border border-gray-200/90 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 cursor-pointer block"
              data-lightbox-src={img}
            >
              <img
                src={img}
                alt={`Portofolio Magang ${idx + 1}`}
                width="800"
                height="600"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-300 flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-white/95 backdrop-blur-md text-maroon-800 flex items-center justify-center opacity-0 group-hover:opacity-100 scale-90 group-hover:scale-100 transition-all duration-300 shadow-xl">
                  <span class="text-base font-bold">↗</span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Clean Image Lightbox Modal (Pure Image Zoom, No text explanations) -->
  <dialog
    id="lightbox-modal"
    class="fixed inset-0 m-auto p-0 max-w-4xl w-[94vw] rounded-[24px] border-0 bg-transparent text-gray-900 shadow-2xl backdrop:bg-black/85 backdrop:backdrop-blur-sm z-50 overflow-hidden"
  >
    <div class="relative flex flex-col items-center justify-center p-2">
      <button
        type="button"
        id="close-lightbox"
        class="absolute -top-2 right-2 sm:top-2 sm:right-2 z-20 w-10 h-10 rounded-full bg-black/60 hover:bg-black/80 text-white flex items-center justify-center text-2xl font-bold transition-colors cursor-pointer"
        aria-label="Tutup Pratinjau"
      >
        &times;
      </button>
      <img
        id="lightbox-img"
        src=""
        alt="Pratinjau Portofolio"
        class="max-h-[85vh] w-auto max-w-full rounded-2xl object-contain shadow-2xl"
      />
    </div>
  </dialog>

  <CtaBanner
    title="Ingin Membangun Portofolio Nyata Seperti Ini?"
    subtitle="Program Magang Informatika di Kota Malang membuka kesempatan bagi siswa SMK dan mahasiswa untuk mengerjakan proyek langsung bersama mentor industri."
    primaryText="Daftar Sekarang"
    primaryHref="/pendaftaran/"
  />
</BaseLayout>

<script>
  function setupLightbox() {
    const triggers = document.querySelectorAll<HTMLElement>("[data-lightbox-src]");
    const modal = document.getElementById("lightbox-modal") as HTMLDialogElement;
    const modalImg = document.getElementById("lightbox-img") as HTMLImageElement;
    const closeBtn = document.getElementById("close-lightbox");

    if (!triggers.length || !modal) return;

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const src = trigger.dataset.lightboxSrc;
        if (src && modalImg) {
          modalImg.src = src;
          modal.showModal();
        }
      });
    });

    closeBtn?.addEventListener("click", () => {
      modal?.close();
    });

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });
  }

  setupLightbox();
  document.addEventListener("astro:page-load", setupLightbox);
</script>
